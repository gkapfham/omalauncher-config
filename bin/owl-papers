#!/usr/bin/env python3
"""owl-papers — what's new on arXiv, for omalauncher's papers tile and for the terminal.

No account and no API key: it asks arXiv's own API for the searches in ~/.config/owl-papers/queries and prints
the newest of each as JSON. The tile reads that; which papers you've looked at is the tile's own business.

    owl-papers                the newest, for a terminal
    owl-papers 25             that many
    owl-papers json           JSON, which 50-papers.owl reads
    owl-papers json --force   fetch again, even when what's cached is a minute old
    owl-papers json --max 60  a longer list than the queries file's `max:`, for the tile's "load 20 more"
    owl-papers queries        what it watches

The queries file has one search per line, `label: arXiv search`, where the label is what the tile's chips say
and the search is what arxiv.org's own search field takes (`ti:"flaky" OR abs:"flaky test"`, `cat:cs.SE`).
`max:` is how many the answer holds and `per:` how many each search asks arXiv for. Without that file it uses
the defaults below: software testing, flaky tests, program repair and LLM agents, and cs.SE's newest.

arXiv asks for one request every three seconds, so a fetch of five searches takes about fifteen; the answer is
cached for five minutes, so the tile costs nothing when you come back to its page.
"""

import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime
from pathlib import Path

API = "https://export.arxiv.org/api/query"
UA = "owl-papers/1.0 (omalauncher widget; +https://github.com/SimonSchubert/omalauncher)"
QUERIES = Path(os.environ.get("OWL_PAPERS_QUERIES", Path.home() / ".config/owl-papers/queries"))
CACHE = Path(os.environ.get("OWL_PAPERS_CACHE", Path.home() / ".cache/owl-papers/last.json"))
TTL = 300  # seconds a fetched answer stays good enough to answer with, unless --force
PAUSE = 3  # seconds between requests, as arXiv asks
ATOM = "{http://www.w3.org/2005/Atom}"
ARXIV = "{http://arxiv.org/schemas/atom}"

DEFAULTS = """\
# Software testing, the flaky tests I write about, program repair, and LLM agents at them: one arXiv search per
# line, `label: search`. The label is what the tile's filter chips say, so keep it one word where you can.
flaky: ti:"flaky" OR abs:"flaky test" OR abs:"test flakiness"
testing: ti:"software testing" OR ti:"test generation" OR ti:"regression testing" OR ti:"test suite" OR ti:"mutation testing" OR ti:"test oracle"
repair: ti:"fault localization" OR ti:"program repair" OR ti:"automated repair"
agents: ti:"LLM" AND (ti:"test" OR ti:"testing" OR ti:"verification")
# The newest testing work in cs.SE, so there is always something from today.
recent: cat:cs.SE AND abs:"test"
max: 40
per: 10
"""


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def collapse(text):
    return " ".join((text or "").split())


def unix(iso):
    return int(datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp())


def parse_queries(text):
    """(searches, max, per) from a queries file's text: `label: search` lines, `max:` and `per:` among them."""
    searches, most, per = [], 40, 10
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        m = re.match(r"^([\w.\-]+)\s*:\s*(.+)$", line)
        if not m:
            continue
        label, query = m.group(1), m.group(2).strip()
        if label == "max":
            most = max(1, int(query))
        elif label == "per":
            per = max(1, int(query))
        else:
            searches.append((label, query))
    return searches, most, per


def read_queries():
    """The searches to run: the queries file's, or the defaults when there is none (or it names none)."""
    try:
        searches, most, per = parse_queries(QUERIES.read_text())
    except OSError:
        searches = []
    if searches:
        return searches, most, per
    return parse_queries(DEFAULTS)


def fetch(query, per):
    params = {
        "search_query": query,
        "start": 0,
        "max_results": per,
        # Newest first: a feed is what came out lately, not what arXiv thinks matters.
        "sortBy": "submittedDate",
        "sortOrder": "descending",
    }
    url = API + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"User-Agent": UA})
    for attempt in range(2):
        try:
            with urllib.request.urlopen(request, timeout=25) as response:
                return response.read()
        except Exception as error:
            if attempt:
                raise error
            time.sleep(5)
    return b""


def parse(data, label):
    """The entries arXiv answered with, as the flat maps the tile reads."""
    items = []
    for entry in ET.fromstring(data).findall(ATOM + "entry"):
        link = entry.findtext(ATOM + "id") or ""
        base = re.sub(r"v\d+$", "", link.rsplit("/", 1)[-1])
        if not base:
            continue
        authors = [collapse(a.findtext(ATOM + "name")) for a in entry.findall(ATOM + "author")]
        published = entry.findtext(ATOM + "published")
        category = entry.find(ARXIV + "primary_category")
        items.append(
            {
                "id": base,
                "t": collapse(entry.findtext(ATOM + "title")) or "(no title)",
                "p": unix(published) if published else int(time.time()),
                "a": [a for a in authors if a],
                "n": len([a for a in authors if a]),
                "c": category.get("term") if category is not None else "",
                "q": [label],
                "s": collapse(entry.findtext(ATOM + "summary"))[:900],
                "cm": collapse(entry.findtext(ARXIV + "comment")).rstrip(".")[:160],
                "j": collapse(entry.findtext(ARXIV + "journal_ref"))[:80],
            }
        )
    items.sort(key=lambda i: -i["p"])
    return items


def gather(searches, most, per):
    """One list per search, merged by arXiv id, then a round of each in turn so one busy search can't fill it."""
    lists, by_id = [], {}
    for n, (label, query) in enumerate(searches):
        if n:
            time.sleep(PAUSE)
        try:
            items = parse(fetch(query, per), label)
        except Exception as error:
            raise RuntimeError(explain(error)) from error
        lists.append([i["id"] for i in items])
        for item in items:
            known = by_id.get(item["id"])
            if known is None:
                by_id[item["id"]] = item
            elif label not in known["q"]:
                known["q"].append(label)
    chosen, taken = [], set()
    for round_index in range(most):
        for ids in lists:
            if round_index < len(ids) and ids[round_index] not in taken:
                taken.add(ids[round_index])
                chosen.append(by_id[ids[round_index]])
                if len(chosen) >= most:
                    break
        if len(chosen) >= most:
            break
    chosen.sort(key=lambda i: -i["p"])
    counts = {}
    for item in by_id.values():
        for label in item["q"]:
            counts[label] = counts.get(label, 0) + 1
    queries = [{"l": label, "n": counts.get(label, 0)} for label, _ in searches]
    return {"at": int(time.time()), "max": most, "queries": queries, "items": chosen}


def explain(error):
    """Why arXiv couldn't be asked, short: the network, its busyness, or what it said."""
    text = collapse(str(error))
    for clue in ("Connection refused", "timed out", "timeout", "Name or service not known", "Temporary failure", "Network is unreachable", "No route to host"):
        if clue.lower() in text.lower():
            return "no network"
    if "503" in text or "429" in text:
        return "arXiv is busy"
    return text[:120] or "couldn't ask arXiv"


def read_cache():
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return None


def write_cache(answer):
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(answer, separators=(",", ":")))
    except OSError:
        pass


def update(force=False, most=None):
    """What to print: the cached answer while it's young and long enough, else a fresh one, and the cache when a
    fetch fails. `most` asks for a longer list than the queries file's `max:`, which is how "load 20 more" works."""
    searches, configured, per = read_queries()
    most = max(1, most or configured)
    # A longer list needs more from each search: a round of each in turn can only add up to what each one gave.
    per = max(per, -(-most // max(1, len(searches))))
    cached = read_cache()
    if cached and not force and time.time() - (cached.get("at") or 0) < TTL and (cached.get("max") or 0) >= most:
        return cached, None
    try:
        answer = gather(searches, most, per)
    except Exception as error:
        # The failure goes into the cache too, so the tile keeps saying it's offline until a fetch works,
        # rather than going quiet after the widget's next read, five minutes later.
        message = explain(error)
        if cached:
            answer = {**cached, "stale": True, "error": message}
        else:
            answer = {"at": int(time.time()), "queries": [], "items": [], "error": message}
        write_cache(answer)
        return answer, message
    write_cache(answer)
    return answer, None


def pretty(answer, count):
    items = answer.get("items") or []
    tags = ", ".join(q["l"] for q in answer.get("queries") or [])
    if not items:
        return answer.get("error") or "Nothing yet: arXiv didn't answer."
    if answer.get("stale"):
        print(f"arXiv didn't answer ({answer.get('error')}); what I last had:", file=sys.stderr)
    lines = [f"{len(items)} papers from {tags or 'arXiv'}, newest first:"]
    for item in items[:count]:
        age = max(0, int((time.time() - item["p"]) / 86400))
        authors = item["a"][:2]
        who = ", ".join(authors) + (f" +{item['n'] - 2}" if item["n"] > 2 else "")
        lines.append("")
        lines.append(f"  {age}d  {collapse(item['t'])}")
        lines.append(f"       {who} · arXiv:{item['id']} · {item['c']}")
    return "\n".join(lines)


def main(argv):
    args = [a for a in argv[1:] if not a.startswith("--")]
    force = "--force" in argv
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    most = None
    for i, a in enumerate(argv[1:]):
        if a == "--max" and i + 2 <= len(argv) - 1:
            most = int(argv[i + 2])
    command = args[0] if args else "papers"
    if command.isdigit():
        args.insert(0, "papers")
        command = "papers"
    if command == "queries":
        searches, most, per = read_queries()
        for label, query in searches:
            print(f"{label}: {query}")
        print(f"max: {most}\nper: {per}")
        return 0
    if command in ("json", "papers", "new"):
        answer, problem = update(force, most)
        if command == "json":
            print(json.dumps(answer, separators=(",", ":")))
        else:
            count = int(args[1]) if len(args) > 1 and args[1].isdigit() else 15
            print(pretty(answer, count))
        return 1 if problem and not answer.get("items") else 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
