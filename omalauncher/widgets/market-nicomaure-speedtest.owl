widget "speedtest" {
  size: 9x10
  minSize: 3x3
  padding: 12

  meta {
    owl: 12
    description: "One-tap internet speed test powered by Fast.com (Netflix CDN) and Cloudflare, in your theme's colors: download, upload, ping, jitter, history, and a CLI."
    version: "2.0"
    license: "MIT"
    category: "system"
  }

  requires { pacman: ["curl", "jq", "ncurses"] }

  source live = file("~/.local/share/omalauncher/speedtest/status.json") json
  source boot = cmd("""
    d="$HOME/.local/share/omalauncher/speedtest"
    mkdir -p "$d"
    if [ ! -s "$d/status.json" ]; then
      printf '{"running":false,"phase":"READY","step":"Tap widget to run speed test","progress":0,"down":0,"up":0,"ping":0,"jitter":0,"ip":"—","isp":"Ready to test","server":"Auto CDN","engine":"fast","history":[]}\n' > "$d/status.json"
    elif jq -e '(.running == true and ((now - (.ts // 0)) > 25)) or (.phase == "ERROR" and ((now - (.ts // 0)) > 120))' "$d/status.json" >/dev/null 2>&1; then
      jq -c '.running = false | .phase = "READY" | .step = "Tap to test again"' "$d/status.json" > "$d/status.json.tmp" && mv "$d/status.json.tmp" "$d/status.json"
    fi
    cat "$d/status.json"
  """) every 5s json

  let data = live.phase != null ? live : boot
  let running = data.running ?? false
  let phase = data.phase ?? "READY"
  let stepText = data.step ?? "Tap anywhere to test speed"
  let progress = num(data.progress, 0)
  let down = num(data.down, 0)
  let up = num(data.up, 0)
  let ping = num(data.ping, 0)
  let jitter = num(data.jitter, 0)
  let ip = data.ip ?? "—"
  let isp = data.isp ?? "Tap to measure"
  let server = data.server ?? "Auto CDN"
  let engine = data.engine ?? "fast"
  let hist = data.history ?? []
  let failed = !running && phase == "ERROR"
  let downText = down > 0 ? fixed(down, 1) : "—"
  let upText = up > 0 ? fixed(up, 1) : "—"
  let pingText = ping > 0 ? "${round(ping)}" : "—"
  let jitterText = jitter > 0 ? "${round(jitter)}" : "—"

  // Every color comes from the launcher's theme, so the tile follows your Omarchy colors
  let cCard = alpha(foreground, 0.05)
  let cCardHi = alpha(foreground, 0.10)
  let cLine = alpha(foreground, 0.14)
  let cMuted = muted
  let cAccent = accent
  let cUp = blue
  let cPing = cyan
  let cJit = green
  let cBad = red

  // Size to the cell the tile got, so it reads at a glance when big and still fits when small
  let tw = tileWidth ?? 380
  let th = tileHeight ?? 440
  let wide = tw >= 300
  let dial = clamp(th - 240, 110, 220)
  let vs = th >= 400 ? 30 : th >= 340 ? 24 : 20

  // Ping only gates the top tier, so the grade and the gauge always agree
  let tier = down <= 0 ? 0 : (down >= 100 && ping <= 45) ? 4 : down >= 25 ? 3 : down >= 10 ? 2 : 1
  let grade = tier == 4 ? "4K ULTRA · GAMING" : tier == 3 ? "4K STREAM · HD" : tier == 2 ? "HD STREAM · WEB" : tier == 1 ? "BASIC LINK" : running ? "TESTING…" : "READY"
  let tierColor = tier == 4 ? green : tier == 3 ? accent : tier == 2 ? yellow : tier == 1 ? red : muted

  // Normalized 0..1 gauge deflection (smooth curve so 10..250 Mbps all read clearly); while testing it follows progress
  let gaugeRatio = running ? clamp(progress / 100, 0.08, 0.95) : clamp(sqrt(clamp(down, 0, 250) / 250), 0, 1)

  let toggleEngineCmd = """
    d="$HOME/.local/share/omalauncher/speedtest"
    mkdir -p "$d"
    sf="$d/status.json"
    if [ -s "$sf" ]; then
      jq -c '.engine = (if .engine == "cloudflare" then "fast" else "cloudflare" end)' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
    fi
  """

  // Set (not toggle) the engine and only write when it changes, so a handler needs no `if` (owl 9)
  let setFastCmd = """
    sf="$HOME/.local/share/omalauncher/speedtest/status.json"
    if [ -s "$sf" ] && ! jq -e '.engine == "fast"' "$sf" >/dev/null 2>&1; then
      jq -c '.engine = "fast"' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
    fi
  """

  let setCloudflareCmd = """
    sf="$HOME/.local/share/omalauncher/speedtest/status.json"
    if [ -s "$sf" ] && ! jq -e '.engine == "cloudflare"' "$sf" >/dev/null 2>&1; then
      jq -c '.engine = "cloudflare"' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
    fi
  """

  // The token in the Fast.com URLs is the public one fast.com's own web page ships to every visitor; it isn't an account key
  let runTestCmd = """
    d="$HOME/.local/share/omalauncher/speedtest"
    mkdir -p "$d"
    sf="$d/status.json"
    lf="$d/run.pid"
    if [ -f "$lf" ]; then
      oldp=$(cat "$lf" 2>/dev/null || true)
      if [ -n "$oldp" ] && kill -0 "$oldp" 2>/dev/null; then exit 0; fi
    fi
    echo $$ > "$lf"
    trap 'rm -f "$lf"' EXIT
    prev=$(cat "$sf" 2>/dev/null || printf '{}')
    eng=$(printf '%s\n' "$prev" | jq -r '.engine // "fast"')
    update_state() {
      printf '%s\n' "$prev" | jq -c \
        --argjson run "$1" --arg ph "$2" --arg st "$3" --argjson pr "$4" \
        --argjson dn "$5" --argjson up "$6" --argjson pg "$7" --argjson jt "$8" \
        --arg ip "$9" --arg isp "${10}" --arg srv "${11}" --arg eg "$eng" --argjson ts "$(date +%s)" \
        '{
          running: $run, phase: $ph, step: $st, progress: $pr,
          down: $dn, up: $up, ping: $pg, jitter: $jt,
          ip: $ip, isp: $isp, server: $srv, engine: $eg, ts: $ts,
          history: (if ($run == false and $ph == "DONE" and $dn > 0) then (((.history // []) + [$dn]) | .[-20:]) else (.history // []) end)
        }' > "$sf.tmp" && mv "$sf.tmp" "$sf"
      prev=$(cat "$sf")
    }
    old_dn=$(printf '%s\n' "$prev" | jq -r '.down // 0')
    old_up=$(printf '%s\n' "$prev" | jq -r '.up // 0')
    old_pg=$(printf '%s\n' "$prev" | jq -r '.ping // 0')
    old_jt=$(printf '%s\n' "$prev" | jq -r '.jitter // 0')
    old_ip=$(printf '%s\n' "$prev" | jq -r '.ip // "—" | tostring')
    old_isp=$(printf '%s\n' "$prev" | jq -r '.isp // "Probing network…" | tostring')
    old_srv=$(printf '%s\n' "$prev" | jq -r '.server // "Connecting…" | tostring')

    update_state true "PING" "Measuring latency & jitter…" 18 "$old_dn" "$old_up" "$old_pg" "$old_jt" "$old_ip" "$old_isp" "$old_srv"

    set --
    for i in 1 2 3 4 5 6 7 8; do set -- "$@" -o /dev/null "https://speed.cloudflare.com/__down?bytes=0&$i"; done
    rtts=$(curl -s --fail-early --connect-timeout 3 -m 4 -w "%{http_code} %{time_starttransfer}\n" "$@" 2>/dev/null || true)
    pj=$(printf '%s\n' "$rtts" | jq -Rsc '
      [splits("\n") | select(length > 0) | split(" ") | select(.[0] == "200") | (.[1] | tonumber? | . * 1000)] |
      if length > 1 then .[1:] else . end |
      if length == 0 then {p: null, j: null}
      else
        (min | round) as $p |
        (if length > 1 then ([range(0; length-1) as $i | (.[$i+1] - .[$i]) | if . < 0 then -. else . end] | add / length | round | if . < 1 then 1 else . end) else 0 end) as $j |
        {p: $p, j: $j}
      end
    ' 2>/dev/null)
    pg=$(printf '%s\n' "$pj" | jq -r '.p // empty' 2>/dev/null)
    jt=$(printf '%s\n' "$pj" | jq -r '.j // 0' 2>/dev/null)
    if [ -z "$pg" ]; then
      update_state false "ERROR" "No connection" 0 "$old_dn" "$old_up" "$old_pg" "$old_jt" "$old_ip" "$old_isp" "$old_srv"
      exit 0
    fi

    ip="$old_ip"; isp="$old_isp"; srv="$old_srv"; urls=""
    if [ "$eng" = "fast" ]; then
      update_state true "DOWNLOAD" "Testing download via Fast.com CDN…" 48 0 "$old_up" "$pg" "$jt" "$ip" "$isp" "Netflix OCA"
      fmeta=$(curl -s -m 4 "https://api.fast.com/netflix/speedtest/v2?https=true&token=YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm&urlCount=3" 2>/dev/null || true)
      if [ -n "$fmeta" ] && printf '%s\n' "$fmeta" | jq -e '.targets[0].url' >/dev/null 2>&1; then
        ip=$(printf '%s\n' "$fmeta" | jq -r '.client.ip // "—"')
        city=$(printf '%s\n' "$fmeta" | jq -r '.client.location.city // ""')
        cnt=$(printf '%s\n' "$fmeta" | jq -r '.client.location.country // ""')
        asn=$(printf '%s\n' "$fmeta" | jq -r '.client.asn // ""')
        srv=$(printf '%s\n' "$fmeta" | jq -r '.targets[0].location.city // "Netflix OCA"')
        isp="AS${asn} · ${city}, ${cnt}"
        urls=$(printf '%s\n' "$fmeta" | jq -r '.targets[].url')
      fi
    fi

    if [ -z "$urls" ]; then
      update_state true "DOWNLOAD" "Testing download via Cloudflare Edge…" 48 0 "$old_up" "$pg" "$jt" "$ip" "$isp" "Cloudflare Edge"
      imeta=$(curl -s -m 3 "https://ipinfo.io/json" 2>/dev/null || true)
      if [ -n "$imeta" ] && printf '%s\n' "$imeta" | jq -e '.ip' >/dev/null 2>&1; then
        ip=$(printf '%s\n' "$imeta" | jq -r '.ip // "—"')
        isp=$(printf '%s\n' "$imeta" | jq -r '.org // "Cloudflare Net" | sub("^AS[0-9]+ "; "")')
        srv=$(printf '%s\n' "$imeta" | jq -r '.city // "Cloudflare Edge"')
      fi
      urls="https://speed.cloudflare.com/__down?bytes=25000000&s=1
https://speed.cloudflare.com/__down?bytes=25000000&s=2
https://speed.cloudflare.com/__down?bytes=25000000&s=3"
    fi

    update_state true "DOWNLOAD" "Measuring multi-stream download…" 62 0 "$old_up" "$pg" "$jt" "$ip" "$isp" "$srv"
    tdir=$(mktemp -d)
    cleanup() { [ -d "$tdir" ] && rm -f "$tdir"/* && rmdir "$tdir"; }
    idx=0
    for u in $urls; do
      idx=$((idx + 1))
      (curl -s -o /dev/null -m 3 -w "%{speed_download}\n" "$u" > "$tdir/d$idx" 2>/dev/null || true) &
    done
    wait
    dn=$(cat "$tdir"/d* 2>/dev/null | jq -Rsc '[splits("\n") | select(length > 0) | tonumber? | select(. != null and . > 0)] | if length == 0 then 0 else ((add * 8 / 1000000 * 10) | round / 10) end')

    if [ -z "$dn" ] || [ "$dn" = "0" ]; then
      cleanup
      update_state false "ERROR" "Download failed" 0 "$old_dn" "$old_up" "$old_pg" "$old_jt" "$old_ip" "$old_isp" "$old_srv"
      exit 0
    fi

    update_state true "UPLOAD" "Measuring multi-stream upload…" 85 "$dn" 0 "$pg" "$jt" "$ip" "$isp" "$srv"
    for s in 1 2; do
      (dd if=/dev/zero bs=100000 count=15 2>/dev/null | curl -s -o /dev/null -m 3 -w "%{speed_upload}\n" --data-binary @- "https://speed.cloudflare.com/__up?s=$s" > "$tdir/u$s" 2>/dev/null || true) &
    done
    wait
    up=$(cat "$tdir"/u* 2>/dev/null | jq -Rsc '[splits("\n") | select(length > 0) | tonumber? | select(. != null and . > 0)] | if length == 0 then 0 else ((add * 8 / 1000000 * 10) | round / 10) end')
    cleanup
    [ -n "$up" ] || up=0

    update_state false "DONE" "Test complete · Tap to re-run" 100 "$dn" "$up" "$pg" "$jt" "$ip" "$isp" "$srv"
  """

  // Same public Fast.com token as in runTestCmd
  let termCmd = """
    mkdir -p "$HOME/.local/share/omalauncher/speedtest"
    sf="$HOME/.local/share/omalauncher/speedtest/status.json"
    ENG=$(jq -r '.engine // "fast"' "$sf" 2>/dev/null || echo "fast")
    # ANSI colors, so the CLI wears the terminal's own Omarchy theme
    C0='\033[0m'
    C_HI='\033[1;33m'
    C_SOFT='\033[1;36m'
    C_DIM='\033[36m'
    C_TEXT='\033[1;37m'
    C_MUTED='\033[2m'
    C_GOOD='\033[1;32m'
    C_BAD='\033[1;31m'

    bar() {
      local pct=$1 w=28
      local fill=$(( pct * w / 100 ))
      local empty=$(( w - fill ))
      printf "${C_DIM}["
      if [ "$fill" -gt 0 ]; then
        for _ in $(seq 1 "$fill"); do printf "${C_HI}█"; done
      fi
      if [ "$empty" -gt 0 ]; then
        for _ in $(seq 1 "$empty"); do printf "${C_MUTED}░"; done
      fi
      printf "${C_DIM}] ${C_HI}%3d%%${C0}" "$pct"
    }

    cli_run() {
      clear
      printf "${C_DIM}╔══════════════════════════════════════════════════════╗${C0}\n"
      printf "${C_DIM}║  ${C_HI}⚡ SPEEDTEST CLI${C_MUTED}  ·  ENGINE: ${C_TEXT}%-16s${C_DIM}║${C0}\n" "$(echo "$ENG" | tr 'a-z' 'A-Z')"
      printf "${C_DIM}╚══════════════════════════════════════════════════════╝${C0}\n\n"

      printf "  ${C_SOFT}▸ [1/3] PING & JITTER${C0}     "
      bar 25
      set --
      for i in 1 2 3 4 5 6 7 8; do set -- "$@" -o /dev/null "https://speed.cloudflare.com/__down?bytes=0&$i"; done
      rtts=$(curl -s --fail-early --connect-timeout 3 -m 4 -w "%{http_code} %{time_starttransfer}\n" "$@" 2>/dev/null || true)
      pj=$(printf '%s\n' "$rtts" | jq -Rsc '
        [splits("\n") | select(length > 0) | split(" ") | select(.[0] == "200") | (.[1] | tonumber? | . * 1000)] |
        if length > 1 then .[1:] else . end |
        if length == 0 then {p: null, j: null}
        else (min | round) as $p | (if length > 1 then ([range(0; length-1) as $i | (.[$i+1] - .[$i]) | if . < 0 then -. else . end] | add / length | round | if . < 1 then 1 else . end) else 0 end) as $j | {p: $p, j: $j} end
      ' 2>/dev/null)
      pg=$(printf '%s\n' "$pj" | jq -r '.p // empty' 2>/dev/null)
      jt=$(printf '%s\n' "$pj" | jq -r '.j // 0' 2>/dev/null)
      if [ -z "$pg" ]; then
        printf "\r  ${C_BAD}✗ [1/3] PING & JITTER${C0}     ${C_BAD}No connection${C0}\033[K\n\n"
        return 1
      fi
      printf "\r  ${C_GOOD}✓ [1/3] PING & JITTER${C0}     ${C_HI}%s ms${C_MUTED} (jitter: ${C_TEXT}%s ms${C_MUTED})\033[K\n\n" "$pg" "$jt"

      printf "  ${C_SOFT}▸ [2/3] DOWNLOAD SPEED${C0}    "
      bar 60
      urls=""; ip="—"; isp="Network"; srv="Edge CDN"
      if [ "$ENG" = "fast" ]; then
        fmeta=$(curl -s -m 4 "https://api.fast.com/netflix/speedtest/v2?https=true&token=YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm&urlCount=3" 2>/dev/null || true)
        if [ -n "$fmeta" ] && printf '%s\n' "$fmeta" | jq -e '.targets[0].url' >/dev/null 2>&1; then
          ip=$(printf '%s\n' "$fmeta" | jq -r '.client.ip // "—"')
          city=$(printf '%s\n' "$fmeta" | jq -r '.client.location.city // ""')
          cnt=$(printf '%s\n' "$fmeta" | jq -r '.client.location.country // ""')
          asn=$(printf '%s\n' "$fmeta" | jq -r '.client.asn // ""')
          srv=$(printf '%s\n' "$fmeta" | jq -r '.targets[0].location.city // "Netflix OCA"')
          isp="AS${asn} · ${city}, ${cnt}"
          urls=$(printf '%s\n' "$fmeta" | jq -r '.targets[].url')
        fi
      fi
      if [ -z "$urls" ]; then
        imeta=$(curl -s -m 3 "https://ipinfo.io/json" 2>/dev/null || true)
        ip=$(printf '%s\n' "$imeta" | jq -r '.ip // "—"' 2>/dev/null || echo "—")
        isp=$(printf '%s\n' "$imeta" | jq -r '.org // "Cloudflare"' 2>/dev/null || echo "Cloudflare")
        srv=$(printf '%s\n' "$imeta" | jq -r '.city // "Cloudflare Edge"' 2>/dev/null || echo "Cloudflare Edge")
        urls="https://speed.cloudflare.com/__down?bytes=25000000&s=1
https://speed.cloudflare.com/__down?bytes=25000000&s=2
https://speed.cloudflare.com/__down?bytes=25000000&s=3"
      fi
      tdir=$(mktemp -d)
      cleanup() { [ -d "$tdir" ] && rm -f "$tdir"/* && rmdir "$tdir"; }
      idx=0
      for u in $urls; do
        idx=$((idx + 1))
        (curl -s -o /dev/null -m 3 -w "%{speed_download}\n" "$u" > "$tdir/d$idx" 2>/dev/null || true) &
      done
      wait
      dn=$(cat "$tdir"/d* 2>/dev/null | jq -Rsc '[splits("\n") | select(length > 0) | tonumber? | select(. != null and . > 0)] | if length == 0 then 0 else ((add * 8 / 1000000 * 10) | round / 10) end')
      if [ -z "$dn" ] || [ "$dn" = "0" ]; then
        cleanup
        printf "\r  ${C_BAD}✗ [2/3] DOWNLOAD SPEED${C0}    ${C_BAD}Download failed${C0}\033[K\n\n"
        return 1
      fi
      printf "\r  ${C_GOOD}✓ [2/3] DOWNLOAD SPEED${C0}    ${C_HI}%s Mbps${C_MUTED} (server: ${C_TEXT}%s${C_MUTED})\033[K\n\n" "$dn" "$srv"

      printf "  ${C_SOFT}▸ [3/3] UPLOAD SPEED${C0}      "
      bar 88
      for s in 1 2; do
        (dd if=/dev/zero bs=100000 count=15 2>/dev/null | curl -s -o /dev/null -m 3 -w "%{speed_upload}\n" --data-binary @- "https://speed.cloudflare.com/__up?s=$s" > "$tdir/u$s" 2>/dev/null || true) &
      done
      wait
      up=$(cat "$tdir"/u* 2>/dev/null | jq -Rsc '[splits("\n") | select(length > 0) | tonumber? | select(. != null and . > 0)] | if length == 0 then 0 else ((add * 8 / 1000000 * 10) | round / 10) end')
      cleanup
      [ -n "$up" ] || up=0
      printf "\r  ${C_GOOD}✓ [3/3] UPLOAD SPEED${C0}      ${C_SOFT}%s Mbps${C0}                              \n\n" "$up"

      prev=$(cat "$sf" 2>/dev/null || printf '{}')
      printf '%s\n' "$prev" | jq -c \
        --arg ph "DONE" --arg st "Completed in the CLI" \
        --argjson dn "$dn" --argjson up "$up" --argjson pg "$pg" --argjson jt "$jt" \
        --arg ip "$ip" --arg isp "$isp" --arg srv "$srv" --arg eg "$ENG" --argjson ts "$(date +%s)" \
        '{running:false,phase:$ph,step:$st,progress:100,down:$dn,up:$up,ping:$pg,jitter:$jt,ip:$ip,isp:$isp,server:$srv,engine:$eg,ts:$ts,history:(((.history//[])+[$dn])|.[-20:])}' > "$sf.tmp" && mv "$sf.tmp" "$sf"

      printf "${C_DIM}┌────────────────────────┬────────────────────────┐${C0}\n"
      printf "${C_DIM}│ ${C_MUTED}↓ DOWNLOAD             ${C_DIM}│ ${C_MUTED}↑ UPLOAD               ${C_DIM}│${C0}\n"
      printf "${C_DIM}│ ${C_HI}%-14s Mbps    ${C_DIM}│ ${C_SOFT}%-14s Mbps    ${C_DIM}│${C0}\n" "$dn" "$up"
      printf "${C_DIM}├────────────────────────┼────────────────────────┤${C0}\n"
      printf "${C_DIM}│ ${C_MUTED}◎ PING / JITTER        ${C_DIM}│ ${C_MUTED}◈ SERVER / CLIENT IP   ${C_DIM}│${C0}\n"
      printf "${C_DIM}│ ${C_TEXT}%-22s ${C_DIM}│ ${C_TEXT}%-22s ${C_DIM}│${C0}\n" "${pg} ms (${jt} ms)" "${srv} (${ip})"
      printf "${C_DIM}└────────────────────────┴────────────────────────┘${C0}\n"
      printf "  ${C_MUTED}ISP:${C0} ${C_TEXT}%s${C0}\n\n" "$isp"
    }

    while true; do
      cli_run
      printf "  ${C_HI}[ENTER]${C_TEXT} Re-run   ${C_HI}[E]${C_TEXT} Switch Engine (Fast/CF)   ${C_HI}[Q]${C_TEXT} Quit: ${C0}"
      read -r ans
      if [ "$ans" = "q" ] || [ "$ans" = "Q" ]; then
        break
      elif [ "$ans" = "e" ] || [ "$ans" = "E" ]; then
        if [ "$ENG" = "fast" ]; then ENG="cloudflare"; else ENG="fast"; fi
      fi
    done
  """

  onTap: { haptic(); run(runTestCmd) }

  component Gauge(dialSize) {
    Canvas {
      size: dialSize
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2 - 8
      // Outer ring, red when the last run failed
      circle(cx, cy, r + 4, stroke: alpha(failed ? cBad : cAccent, running ? 0.4 : 0.18), width: 1.5)
      // Track (225° to 495°) and its ticks
      arc(cx, cy, r, 225, 270, stroke: alpha(cMuted, 0.22), width: 8, cap: round)
      for i in range(13) {
        let ang = 225 + i * 22.5
        rotate(ang, cx, cy) {
          line(cx, cy - r + 7, cx, cy - r + 12, stroke: i <= gaugeRatio * 12 ? cAccent : alpha(cMuted, 0.35), width: 2, cap: round)
        }
      }
      // The live arc, in the theme's accent
      if gaugeRatio > 0.01 {
        arc(cx, cy, r, 225, 270 * gaugeRatio, stroke: linear(0, height, width, 0, [alpha(cAccent, 0.5), cAccent]), width: 8, cap: round)
      }
      // Readout
      let mainVal = running ? "${progress}%" : downText
      text(running ? phase : failed ? "ERROR" : (engine == "fast" ? "FAST.COM" : "CLOUDFLARE"), cx, cy - r * 0.58, size: dialSize * 0.075, color: failed ? cBad : cMuted, align: center, bold: true)
      text(mainVal, cx, cy + dialSize * 0.06, size: dialSize * 0.19, color: failed ? cBad : foreground, align: center, bold: true)
      text(running ? "TESTING" : "Mbps", cx, cy + r * 0.52, size: dialSize * 0.085, color: cAccent, align: center, bold: true)
      text(running ? "● LIVE" : failed ? "● FAILED" : "● READY", cx, cy + r * 0.80, size: dialSize * 0.07, color: running ? cJit : failed ? cBad : cMuted, align: center, bold: true)
    }
  }

  component Stat(label, val, unit, tint, vs) {
    Box {
      weight: 1
      padding: [10, 12]
      radius: 10 * corners
      background: cCard
      border: 1
      borderColor: alpha(tint, 0.3)
      Column {
        gap: 2
        Text { text: label; fontSize: 10; font: mono; bold: true; color: cMuted; letterSpacing: 1; maxLines: 1 }
        Row {
          gap: 5
          align: bottom
          Text { text: val; fontSize: vs; font: mono; bold: true; color: tint; maxLines: 1 }
          Text { text: unit; fontSize: 10; font: mono; color: cMuted; maxLines: 1 }
        }
      }
    }
  }

  Column {
    gap: 8
    fill: true

    if wide {
      Row {
        gap: 8
        align: center
        Text {
          text: running ? "◌ ${phase}" : failed ? "⚠ SPEEDTEST" : "⚡ SPEEDTEST"
          fontSize: 17
          font: mono
          bold: true
          color: failed ? cBad : cAccent
          maxLines: 1
        }
        Text {
          text: grade
          fontSize: 10
          font: mono
          bold: true
          letterSpacing: 1
          color: failed ? cBad : tierColor
          weight: 1
          align: end
          maxLines: 1
        }
        Box {
          width: 66
          padding: [6, 4]
          radius: 6 * corners
          background: cCardHi
          border: 1
          borderColor: cLine
          onTap: { haptic(); screen() }
          Text { text: "INFO ⤢"; fontSize: 10; font: mono; bold: true; color: foreground; align: center; maxLines: 1 }
        }
      }

      // Tap the dial to run a test
      Box {
        weight: 1
        align: center
        onTap: { haptic(); run(runTestCmd) }
        Gauge { dialSize: dial }
      }

      Row {
        gap: 8
        Stat { label: "DOWNLOAD"; val: downText; unit: "Mbps"; tint: cAccent; vs: vs }
        Stat { label: "UPLOAD"; val: upText; unit: "Mbps"; tint: cUp; vs: vs }
      }
      Row {
        gap: 8
        Stat { label: "PING"; val: pingText; unit: "ms"; tint: cPing; vs: vs }
        Stat { label: "JITTER"; val: jitterText; unit: "ms"; tint: cJit; vs: vs }
      }

      if running {
        Column {
          gap: 4
          Progress { value: progress; max: 100; color: cAccent; track: cCard; animate value: spring() }
          Text { text: stepText; fontSize: 10; font: mono; color: cMuted; maxLines: 1 }
        }
      } else {
        Row {
          gap: 8
          align: center
          Box {
            width: 96
            padding: [6, 4]
            radius: 6 * corners
            background: cCardHi
            border: 1
            borderColor: cLine
            onTap: { haptic(); run(toggleEngineCmd) }
            Text { text: engine == "fast" ? "FAST.COM" : "CLOUDFLARE"; fontSize: 10; font: mono; bold: true; color: cAccent; align: center; maxLines: 1 }
          }
          Box {
            width: 64
            padding: [6, 4]
            radius: 6 * corners
            background: cCardHi
            border: 1
            borderColor: cLine
            onTap: { haptic(); terminal(termCmd, "Speedtest CLI") }
            Text { text: ">_ CLI"; fontSize: 10; font: mono; bold: true; color: foreground; align: center; maxLines: 1 }
          }
          Text {
            text: failed ? "TAP TO RETRY ↻" : "TAP TO TEST ↻"
            fontSize: 10
            font: mono
            bold: true
            color: failed ? cBad : cAccent
            weight: 1
            align: end
            maxLines: 1
          }
        }
      }
    } else {
      Column {
        gap: 6
        weight: 1
        align: center
        justify: spaceBetween
        Text { text: running ? phase : failed ? "⚠ SPEEDTEST" : "⚡ SPEEDTEST"; fontSize: 12; font: mono; bold: true; color: failed ? cBad : cAccent; maxLines: 1 }
        Box {
          onTap: { haptic(); run(runTestCmd) }
          Gauge { dialSize: 88 }
        }
        Text { text: "↓ ${downText} · ↑ ${upText} Mbps"; fontSize: 10; font: mono; bold: true; color: foreground; maxLines: 1 }
        Text { text: "Ping ${pingText} · Jitter ${jitterText}"; fontSize: 9; font: mono; color: cMuted; maxLines: 1 }
        Text { text: failed ? "tap to retry" : running ? stepText : "tap to test"; fontSize: 9; font: mono; color: failed ? cBad : cMuted; maxLines: 1 }
      }
    }
  }

  screen {
    title: "speedtest"
    Column {
      gap: 12
      padding: 14
      scroll: true
      background: background

      // Header: the gauge, the grade and the two ways to run a test
      Box {
        fill: width
        padding: 14
        radius: 12 * corners
        background: cCard
        border: 1
        borderColor: cLine
        Column {
          gap: 10
          align: center
          Row {
            gap: 8
            align: center
            Text { text: "⚡ SPEEDTEST"; fontSize: 17; font: mono; bold: true; color: cAccent; maxLines: 1 }
            Text { text: grade; fontSize: 10; font: mono; bold: true; letterSpacing: 1; color: tierColor; weight: 1; align: end; maxLines: 1 }
          }
          Box {
            align: center
            onTap: { haptic(); run(runTestCmd) }
            Gauge { dialSize: 220 }
          }
          if running {
            Text { text: stepText; fontSize: 12; font: mono; color: cMuted; align: center; fill: width }
            Progress { value: progress; max: 100; color: cAccent; track: background; animate value: spring() }
          }
          if failed {
            Text { text: "⚠ ${stepText} · tap the gauge to retry"; fontSize: 12; font: mono; color: cBad; align: center; fill: width }
          }
          Row {
            gap: 8
            Button {
              text: running ? "Testing…" : "⚡ Run Speed Test"
              color: running ? cMuted : cAccent
              weight: 2
              onTap: { haptic(); run(runTestCmd) }
            }
            Button {
              text: ">_ CLI"
              color: cUp
              weight: 1
              onTap: { haptic(); terminal(termCmd, "Speedtest CLI") }
            }
          }
        }
      }

      // Live metrics
      Row {
        gap: 8
        Stat { label: "DOWNLOAD"; val: downText; unit: "Mbps"; tint: cAccent; vs: 30 }
        Stat { label: "UPLOAD"; val: upText; unit: "Mbps"; tint: cUp; vs: 30 }
      }
      Row {
        gap: 8
        Stat { label: "PING"; val: pingText; unit: "ms"; tint: cPing; vs: 30 }
        Stat { label: "JITTER"; val: jitterText; unit: "ms"; tint: cJit; vs: 30 }
      }

      // History
      // A sparkline needs at least two runs to draw a line
      if len(hist) > 1 {
        Box {
          fill: width
          padding: 12
          radius: 12 * corners
          background: cCard
          border: 1
          borderColor: cLine
          Column {
            gap: 6
            Row {
              Text { text: "DOWNLOAD HISTORY"; fontSize: 10; font: mono; bold: true; letterSpacing: 1; color: cMuted; weight: 1 }
              Text { text: "Peak ${fixed(max(hist), 1)} Mbps"; fontSize: 10; font: mono; bold: true; color: cAccent; maxLines: 1 }
            }
            Sparkline { values: hist; min: 0; color: cAccent; area: true; height: 56; fill: width }
          }
        }
      }

      // Engine
      Box {
        fill: width
        padding: 12
        radius: 12 * corners
        background: cCard
        border: 1
        borderColor: cLine
        Column {
          gap: 8
          Text { text: "TEST ENGINE"; fontSize: 10; font: mono; bold: true; letterSpacing: 1; color: cMuted }
          Row {
            gap: 8
            Button {
              text: engine == "fast" ? "✓ Fast.com" : "Fast.com"
              color: engine == "fast" ? cAccent : cMuted
              weight: 1
              onTap: { haptic(); run(setFastCmd) }
            }
            Button {
              text: engine == "cloudflare" ? "✓ Cloudflare" : "Cloudflare"
              color: engine == "cloudflare" ? cAccent : cMuted
              weight: 1
              onTap: { haptic(); run(setCloudflareCmd) }
            }
          }
        }
      }

      // Network details
      Box {
        fill: width
        padding: 12
        radius: 12 * corners
        background: cCard
        border: 1
        borderColor: cLine
        Column {
          gap: 8
          Text { text: "CONNECTION DETAILS"; fontSize: 10; font: mono; bold: true; letterSpacing: 1; color: cMuted }
          Row {
            Text { text: "Provider"; fontSize: 12; font: mono; color: cMuted; width: 110; maxLines: 1 }
            Text { text: isp; fontSize: 12; font: mono; color: foreground; weight: 1; maxLines: 1 }
          }
          Row {
            Text { text: "Server"; fontSize: 12; font: mono; color: cMuted; width: 110; maxLines: 1 }
            Text { text: "${server} · ${upper(engine)}"; fontSize: 12; font: mono; color: cAccent; weight: 1; maxLines: 1 }
          }
          Row {
            onTap: { haptic(); copy(ip) }
            Text { text: "External IP"; fontSize: 12; font: mono; color: cMuted; width: 110; maxLines: 1 }
            Text { text: "${ip} ⧉"; fontSize: 12; font: mono; color: cUp; weight: 1; maxLines: 1 }
          }
        }
      }

      Row {
        gap: 8
        Button {
          text: "Share Results"
          color: cUp
          weight: 1
          onTap: { haptic(); share("⚡ Speedtest (${upper(engine)}): ↓ ${fixed(down, 1)} Mbps · ↑ ${fixed(up, 1)} Mbps · Ping ${round(ping)} ms (Jitter ${round(jitter)} ms)") }
        }
        Button { text: "Close"; color: cMuted; weight: 1; onTap: close() }
      }

      // Author credit, kept subtle
      Row {
        Spacer { weight: 1 }
        Box {
          width: 180
          padding: [0, 8]
          onTap: { haptic(); url("https://github.com/nicomaure") }
          Text { text: "by nicomaure ↗"; fontSize: 9; font: mono; color: alpha(cMuted, 0.8); align: center; fill: width; maxLines: 1 }
        }
        Spacer { weight: 1 }
      }
    }
  }
}
