widget "backup" {
  // A home tile for backups: tap back up to save and upload, tap the tile for the saved setups
  // and, for any of them, exactly which files it holds.
  page: 4
  order: 1
  size: 3x3
  minSize: 3x2

  meta {
    owl: 17
    description: "Back up the widgets, style and home layout to Google Drive, and restore a saved setup"
    version: "1.0"
    license: "MIT"
    category: "system"
  }

  requires { pacman: ["python", "nodejs", "npm", "git", "util-linux", "zstd", "tar", "fontconfig"] }

  source st = file("~/.cache/owl-config/status.json") json
  source bl = file("~/.cache/owl-config/backups.json") json
  // owl-config contents writes this: the files inside the backup being looked at.
  source cs = file("~/.cache/owl-config/contents.json") json
  source now = clock every 1m

  state confirm = ""
  // The id of the backup whose files the screen is showing; "" is the list.
  state viewing = ""

  let busy = st != null && (st.state == "saving" || st.state == "restoring")
  // A run that dies (the app frozen, the phone shut down) leaves "saving" behind,
  // and the status only ever changes when the run itself changes it. After this
  // long no run is doing anything any more, so the tile stops saying it is and
  // lets a new one start. owl-config clears the same status at its next command.
  let age = st == null || st.at == null ? 0 : now - st.at
  let staleAfter = st != null && st.state == "restoring" ? 1800 : 600
  let stalled = busy && age > staleAfter
  let working = busy && !stalled
  let stateText = st == null ? "ready" : stalled ? "interrupted" : st.state
  let stateColor = st == null ? muted : st.state == "error" ? red : st.state == "ok" ? green : yellow
  let last = len(bl ?? []) > 0 ? bl[0] : null
  let inside = cs != null && cs.id == viewing ? cs : null
  let saved = bl ?? []
  let kept = len(saved)
  let bytesKept = sum(saved.map(b => b.size ?? 0))
  let when = last == null ? "" : fmtAgo(last.at, now)
  let note = st == null ? "no backup has run from here yet"
    : stalled ? "the last " + (st.state == "restoring" ? "restore" : "backup") + " stopped before it finished; that status isn't live any more"
    : st.message
  // The tile shows as much as it has room for, so it keeps working when it's resized.
  let roomy = (tileHeight ?? 0) >= 230
  let tall = (tileHeight ?? 0) >= 175
  let earlierFit = clamp(floor(((tileHeight ?? 0) - 175) / 28), 0, 6)
  // Trouble gets the line "when · size" would take, so nothing is squeezed out.
  let trouble = st != null && (st.state == "error" || stalled)
  let troubleText = stalled ? "the last run stopped early — tap back up" : st.message

  // First open with no cached list (a new install): fetch it once.
  on bl first {
    if len(bl ?? []) == 0 {
      run("setsid -f $HOME/.local/bin/owl-config list >/dev/null 2>&1 </dev/null")
    }
  }

  onTap: {
    viewing = ""
    screen()
  }

  Column {
    fill: true
    gap: 3
    Row {
      Text { text: "backup"; style: muted; weight: 1 }
      Text { text: stateText; style: small; color: stateColor }
    }
    if last != null {
      Row {
        align: end
        gap: 8
        Text { text: fmtTime(last.at, "d MMM"); style: title; weight: 1; maxLines: 1 }
        Text { text: fmtTime(last.at, "HH:mm"); style: small; color: muted }
      }
      Text {
        text: (when == "now" ? "just now" : when + " ago") + (last.size != null ? " · " + fmtBytes(last.size) : "")
        style: small
        color: muted
        maxLines: 1
      }
    } else {
      Text { text: "no backups yet"; style: small; color: muted }
    }
    if trouble {
      Text { text: troubleText; style: small; color: stateColor; maxLines: 2 }
    }
    if roomy && kept > 0 {
      Text { text: "${kept} saved · " + fmtBytes(bytesKept); style: small; color: muted; maxLines: 1 }
    }
    if tall && earlierFit > 0 && kept > 1 {
      Text { text: "earlier"; style: label }
      for b in saved.drop(1).take(earlierFit) key b.id {
        Row {
          fill: width
          gap: 8
          align: center
          Text { text: fmtTime(b.at, "EEE d MMM"); style: small; color: muted; weight: 1; maxLines: 1 }
          Text { text: fmtBytes(b.size ?? 0); style: small; color: muted }
        }
      }
    }
    Spacer { weight: 1 }
    Button {
      text: working ? "working…" : "back up"
      color: working ? muted : accent
      onTap: {
        if !working {
          run("setsid -f $HOME/.local/bin/owl-config save >/dev/null 2>&1 </dev/null")
        }
      }
    }
  }

  screen {
    title: viewing == "" ? "backup" : "what's inside"
    Column {
      fill: true
      gap: 10
      padding: [12, 0, 12, 12]

      if viewing == "" {
        Row {
          gap: 8
          Button {
            text: working ? (st.state == "saving" ? "backing up…" : "restoring…") : "back up now"
            color: working ? muted : accent
            weight: 1
            onTap: {
              if !working {
                run("setsid -f $HOME/.local/bin/owl-config save >/dev/null 2>&1 </dev/null")
              }
            }
          }
          Button {
            text: "refresh list"
            weight: 1
            onTap: run("setsid -f $HOME/.local/bin/owl-config list >/dev/null 2>&1 </dev/null")
          }
        }

        Column {
          fill: width
          gap: 6
          padding: [12, 10]
          background: surface
          radius: 8 * corners
          Row {
            align: center
            gap: 8
            Text { text: stateText; color: stateColor; weight: 1 }
            if st != null && st.at != null {
              Text { text: fmtAgo(st.at, now) == "now" ? "just now" : fmtAgo(st.at, now) + " ago"; style: small; color: muted }
            }
          }
          Text { text: note; style: small; color: muted; maxLines: 3 }
          if st != null && st.link != null {
            Text { text: "open in Drive"; color: accent; style: small; onTap: url(st.link) }
          }
        }

        Text { text: "saved setups"; style: label }
        Text {
          text: "tap one to see its files"
          style: small
          color: muted
          padding: [0, 4]
        }

        Column {
          scroll: true
          weight: 1
          gap: 2
          if len(bl ?? []) == 0 {
            Text { text: "nothing in Drive yet — tap back up now"; style: small; color: muted; padding: [0, 4] }
          }
          for b in bl ?? [] key b.id {
            Row {
              fill: width
              gap: 10
              align: center
              padding: [8, 4]
              onTap: {
                viewing = b.id
                run("setsid -f $HOME/.local/bin/owl-config contents ${sh(b.id)} >/dev/null 2>&1 </dev/null")
              }
              Text { text: fmtTime(b.at, "EEE d MMM  HH:mm"); weight: 1; maxLines: 1 }
              Text { text: fmtBytes(b.size); style: small; color: muted }
              Button { text: "restore"; color: red; onTap: confirm = b.id }
            }
          }
        }

        Text {
          text: "restoring sets the current setup aside first, under ~/.local/share/omalauncher-restored."
          style: small
          color: muted
        }
      } else {
        Row {
          gap: 8
          Button {
            text: "‹ saved setups"
            weight: 1
            onTap: viewing = ""
          }
          if inside != null && inside.link != null {
            Button {
              text: "open in Drive"
              weight: 1
              onTap: url(inside.link)
            }
          }
        }

        Column {
          scroll: true
          weight: 1
          gap: 8

          // What this backup is and how much it holds.
          Column {
            fill: width
            gap: 4
            padding: [12, 10]
            background: surface
            radius: 8 * corners
            Row {
              align: center
              gap: 8
              Text {
                text: inside == null ? "reading the backup…" : inside.state == "error" ? "couldn't read it" : "${inside.total} files"
                weight: 1
                color: inside != null && inside.state == "error" ? red : foreground
              }
              if inside != null && inside.bytes != null {
                Text { text: fmtBytes(inside.bytes); style: small; color: muted }
              }
            }
            if inside != null && inside.at != null {
              Text { text: fmtTime(inside.at, "EEE d MMM  HH:mm"); style: small; color: muted }
            }
            if inside != null && inside.name != null {
              Text { text: inside.name; style: small; color: muted; maxLines: 2 }
            }
            if inside != null && inside.state == "error" {
              Text { text: inside.message; style: small; color: red; maxLines: 4 }
              Button {
                text: "try again"
                onTap: run("setsid -f $HOME/.local/bin/owl-config contents ${sh(viewing)} >/dev/null 2>&1 </dev/null")
              }
            }
            if inside == null || inside.state == "reading" {
              Text { text: "downloading the backup to list what's in it…"; style: small; color: muted }
            }
          }

          // Every file in the archive, under the part of the setup it belongs to.
          for g in inside.groups ?? [] key g.key {
            Column {
              fill: width
              gap: 2
              Row {
                fill: width
                gap: 8
                align: center
                Text { text: g.label; style: label; weight: 1 }
                Text { text: "${g.count} · " + fmtBytes(g.bytes); style: small; color: muted }
              }
              if g.root != "" {
                Text { text: g.root; style: small; color: muted }
              }
              for f in g.files key f.path {
                Row {
                  fill: width
                  gap: 8
                  padding: [2, 4]
                  Text { text: f.path; fontSize: 11; weight: 1; maxLines: 2 }
                  Text { text: f.note ?? fmtBytes(f.size); style: small; color: muted }
                }
              }
            }
          }
        }
      }

      Popup {
        visible: confirm != ""
        onDismiss: confirm = ""
        width: (screenWidth ?? 400) - 48
        gap: 10
        padding: [16, 14]
        Text { text: "restore this setup?"; style: title }
        Text {
          text: "The current widgets, style and layout are set aside first, so this can be undone by hand."
          style: small
          color: muted
        }
        Row {
          gap: 8
          Button { text: "cancel"; weight: 1; onTap: confirm = "" }
          Button {
            text: "restore"
            color: red
            weight: 1
            onTap: {
              run("setsid -f $HOME/.local/bin/owl-config restore ${sh(confirm)} >/dev/null 2>&1 </dev/null")
              confirm = ""
            }
          }
        }
      }
    }
  }
}
