widget "today" {
  page: 1
  order: 1
  size: 3x3
  minSize: 2x2
  meta { description: "The date and the weather where you are, by IP or a city you type. Tap it for the next 24 hours, three days, wind, UV, sun and moon. Tap °C or °F to switch"; version: "1.8"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. The sky comes from Open-Meteo's WMO code and the
  // moon from its phase, named in each language here rather than by the API.
  strings {
    en {
      title: "weather"; loading: "weather…"; offline: "weather offline"; city: "city · empty = auto"
      feels: "feels"; humidity: "humidity"; rainToday: "rain today"; uv: "uv index"; pressure: "pressure"
      visibility: "visibility"; next24: "next 24 hours"; now: "now"; days: "3 days"; today: "today"
      sunrise: "sunrise"; sunset: "sunset"; moon: "moon"; kmh: "km/h"; yr: "open yr.no ↗"
      sky: code => get({
        "0": "clear", "1": "mainly clear", "2": "partly cloudy", "3": "overcast",
        "45": "fog", "48": "freezing fog", "51": "light drizzle", "53": "drizzle",
        "55": "heavy drizzle", "56": "freezing drizzle", "57": "heavy freezing drizzle", "61": "light rain",
        "63": "rain", "65": "heavy rain", "66": "freezing rain", "67": "heavy freezing rain",
        "71": "light snow", "73": "snow", "75": "heavy snow", "77": "snow grains",
        "80": "light showers", "81": "showers", "82": "heavy showers", "85": "light snow showers",
        "86": "snow showers", "95": "thunderstorm", "96": "thunderstorm with hail", "99": "heavy thunderstorm with hail"
      }, code, "")
      wind: dir => "wind ${lower(dir)}"
      uvLevel: uv => uv >= 8 ? "very high" : uv >= 6 ? "high" : uv >= 3 ? "moderate" : "low"
      phase: (phase, lit) => "${lower(phase)} · ${lit}% lit"
      dew: "dew point"; gust: "gusts"; clouds: "clouds"; lowCloud: "low"; midCloud: "mid"; highCloud: "high"; dewShort: "dew"
      windWord: "wind"; surface: "surface"; uvMax: "uv max"; clearSky: "clear sky"; max: "max"
      daylight: "daylight"; sunshine: "sunshine"; air: "air quality"; pollen: "pollen"; airShort: "air"
      grass: "grass"; birch: "birch"; ragweed: "ragweed"; olive: "olive"; mugwort: "mugwort"; alder: "alder"
      solar: "solar"; evap: "evaporation"; freeze: "freezing"; unstable: "instability"; bulb: "wet bulb"
      snow: "snow"; total: "total"; next2h: "next 2 hours"; nextFull: "next full"; nextNew: "next new"; more: "more numbers"
      rainNow: "rain now"; rainIn: m => "rain in ${m} min"; rainStops: m => "rain stops in ${m} min"; dryNext: h => "dry for ${h} h"
      pollenLevel: v => v >= 200 ? "very high" : v >= 50 ? "high" : v >= 10 ? "moderate" : "low"
      aqiLevel: a => a <= 50 ? "good" : a <= 100 ? "moderate" : a <= 150 ? "unhealthy for some" : a <= 200 ? "unhealthy" : a <= 300 ? "very unhealthy" : "hazardous"
    }
    id {
      title: "cuaca"; loading: "cuaca…"; offline: "cuaca offline"; city: "kota · kosong = otomatis"
      feels: "terasa"; humidity: "kelembapan"; rainToday: "hujan hari ini"; uv: "indeks uv"; pressure: "tekanan"
      visibility: "jarak pandang"; next24: "24 jam ke depan"; now: "kini"; days: "3 hari"; today: "hari ini"
      sunrise: "terbit"; sunset: "terbenam"; moon: "bulan"; kmh: "km/jam"; yr: "buka yr.no ↗"
      sky: code => get({
        "0": "cerah", "1": "cerah berawan", "2": "cerah berawan", "3": "mendung",
        "45": "kabut", "48": "kabut beku", "51": "gerimis ringan", "53": "gerimis",
        "55": "gerimis lebat", "56": "gerimis beku", "57": "gerimis beku lebat", "61": "hujan ringan",
        "63": "hujan sedang", "65": "hujan lebat", "66": "hujan beku ringan", "67": "hujan beku lebat",
        "71": "salju ringan", "73": "salju sedang", "75": "salju lebat", "77": "butiran salju",
        "80": "hujan lokal", "81": "hujan sesaat", "82": "hujan deras sesaat", "85": "salju ringan sesaat",
        "86": "salju lebat sesaat", "95": "badai petir", "96": "badai petir dengan hujan es", "99": "badai petir lebat dengan hujan es"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "angin " + get({
        "N": "utara", "NNE": "utara", "NE": "timur laut", "ENE": "timur", "E": "timur", "ESE": "timur",
        "SE": "tenggara", "SSE": "selatan", "S": "selatan", "SSW": "selatan", "SW": "barat daya", "WSW": "barat",
        "W": "barat", "WNW": "barat", "NW": "barat laut", "NNW": "utara"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "sangat tinggi" : uv >= 6 ? "tinggi" : uv >= 3 ? "sedang" : "rendah"
      dew: "titik embun"; gust: "hembusan"; clouds: "awan"; lowCloud: "bawah"; midCloud: "tengah"; highCloud: "atas"; dewShort: "embun"
      windWord: "angin"; surface: "permukaan"; uvMax: "uv maks"; clearSky: "langit cerah"; max: "maks"
      daylight: "siang"; sunshine: "sinar matahari"; air: "kualitas udara"; pollen: "serbuk sari"; airShort: "udara"
      grass: "rumput"; birch: "birch"; ragweed: "ragweed"; olive: "zaitun"; mugwort: "mugwort"; alder: "alder"
      solar: "surya"; evap: "penguapan"; freeze: "beku"; unstable: "ketidakstabilan"; bulb: "bola basah"
      snow: "salju"; total: "total"; next2h: "2 jam ke depan"; nextFull: "purnama berikutnya"; nextNew: "bulan baru berikutnya"; more: "angka lain"
      rainNow: "hujan sekarang"; rainIn: m => "hujan ${m} menit lagi"; rainStops: m => "hujan berhenti ${m} menit lagi"; dryNext: h => "kering ${h} jam"
      pollenLevel: v => v >= 200 ? "sangat tinggi" : v >= 50 ? "tinggi" : v >= 10 ? "sedang" : "rendah"
      aqiLevel: a => a <= 50 ? "baik" : a <= 100 ? "sedang" : a <= 150 ? "tidak sehat bagi sebagian" : a <= 200 ? "tidak sehat" : a <= 300 ? "sangat tidak sehat" : "berbahaya"
      phase: (phase, lit) => get({
        "New Moon": "bulan baru", "Waxing Crescent": "sabit awal", "First Quarter": "kuartir pertama",
        "Waxing Gibbous": "cembung awal", "Full Moon": "purnama", "Waning Gibbous": "cembung akhir",
        "Last Quarter": "kuartir akhir", "Waning Crescent": "sabit akhir"
      }, phase, lower(phase)) + " · ${lit}% terang"
    }
    es {
      title: "clima"; loading: "clima…"; offline: "clima sin conexión"; city: "ciudad · vacío = auto"
      feels: "sensación"; humidity: "humedad"; rainToday: "lluvia hoy"; uv: "índice uv"; pressure: "presión"
      visibility: "visibilidad"; next24: "próximas 24 horas"; now: "ahora"; days: "3 días"; today: "hoy"
      sunrise: "amanecer"; sunset: "atardecer"; moon: "luna"; kmh: "km/h"; yr: "abrir yr.no ↗"
      sky: code => get({
        "0": "despejado", "1": "mayormente despejado", "2": "parcialmente nublado", "3": "cubierto",
        "45": "niebla", "48": "niebla helada", "51": "llovizna ligera", "53": "llovizna",
        "55": "llovizna fuerte", "56": "llovizna helada", "57": "llovizna helada fuerte", "61": "lluvia ligera",
        "63": "lluvia moderada", "65": "lluvia fuerte", "66": "lluvia helada ligera", "67": "lluvia helada fuerte",
        "71": "nevada ligera", "73": "nevada moderada", "75": "nevada fuerte", "77": "granos de nieve",
        "80": "chubascos ligeros", "81": "chubascos", "82": "chubascos fuertes", "85": "chubascos de nieve ligeros",
        "86": "chubascos de nieve fuertes", "95": "tormenta eléctrica", "96": "tormenta con granizo", "99": "tormenta fuerte con granizo"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "viento del " + get({
        "N": "norte", "NNE": "norte", "NE": "noreste", "ENE": "este", "E": "este", "ESE": "este",
        "SE": "sureste", "SSE": "sur", "S": "sur", "SSW": "sur", "SW": "suroeste", "WSW": "oeste",
        "W": "oeste", "WNW": "oeste", "NW": "noroeste", "NNW": "norte"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "muy alto" : uv >= 6 ? "alto" : uv >= 3 ? "moderado" : "bajo"
      phase: (phase, lit) => get({
        "New Moon": "luna nueva", "Waxing Crescent": "creciente", "First Quarter": "cuarto creciente",
        "Waxing Gibbous": "gibosa creciente", "Full Moon": "luna llena", "Waning Gibbous": "gibosa menguante",
        "Last Quarter": "cuarto menguante", "Waning Crescent": "menguante"
      }, phase, lower(phase)) + " · ${lit}% iluminada"
      dew: "punto de rocío"; gust: "rachas"; clouds: "nubes"; lowCloud: "bajas"; midCloud: "medias"; highCloud: "altas"; dewShort: "rocío"
      windWord: "viento"; surface: "superficie"; uvMax: "uv máx"; clearSky: "cielo despejado"; max: "máx"
      daylight: "luz de día"; sunshine: "sol"; air: "calidad del aire"; pollen: "polen"; airShort: "aire"
      grass: "hierba"; birch: "abedul"; ragweed: "ambrosía"; olive: "olivo"; mugwort: "artemisa"; alder: "aliso"
      solar: "solar"; evap: "evaporación"; freeze: "congelación"; unstable: "inestabilidad"; bulb: "bulbo húmedo"
      snow: "nieve"; total: "total"; next2h: "próximas 2 horas"; nextFull: "próxima llena"; nextNew: "próxima nueva"; more: "más datos"
      rainNow: "llueve ahora"; rainIn: m => "lluvia en ${m} min"; rainStops: m => "la lluvia para en ${m} min"; dryNext: h => "seco ${h} h"
      pollenLevel: v => v >= 200 ? "muy alto" : v >= 50 ? "alto" : v >= 10 ? "moderado" : "bajo"
      aqiLevel: a => a <= 50 ? "buena" : a <= 100 ? "moderada" : a <= 150 ? "mala para algunos" : a <= 200 ? "mala" : a <= 300 ? "muy mala" : "peligrosa"
    }
    pt {
      title: "clima"; loading: "clima…"; offline: "clima offline"; city: "cidade · vazio = auto"
      feels: "sensação"; humidity: "umidade"; rainToday: "chuva hoje"; uv: "índice uv"; pressure: "pressão"
      visibility: "visibilidade"; next24: "próximas 24 horas"; now: "agora"; days: "3 dias"; today: "hoje"
      sunrise: "nascer do sol"; sunset: "pôr do sol"; moon: "lua"; kmh: "km/h"; yr: "abrir yr.no ↗"
      sky: code => get({
        "0": "céu limpo", "1": "pouco nublado", "2": "parcialmente nublado", "3": "encoberto",
        "45": "neblina", "48": "neblina congelante", "51": "garoa fraca", "53": "garoa",
        "55": "garoa forte", "56": "garoa congelante", "57": "garoa congelante forte", "61": "chuva fraca",
        "63": "chuva moderada", "65": "chuva forte", "66": "chuva congelante fraca", "67": "chuva congelante forte",
        "71": "neve fraca", "73": "neve moderada", "75": "neve forte", "77": "grãos de neve",
        "80": "pancadas de chuva fracas", "81": "pancadas de chuva", "82": "pancadas de chuva fortes", "85": "pancadas de neve fracas",
        "86": "pancadas de neve fortes", "95": "trovoada", "96": "trovoada com granizo", "99": "trovoada forte com granizo"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "vento " + get({
        "N": "norte", "NNE": "norte", "NE": "nordeste", "ENE": "leste", "E": "leste", "ESE": "leste",
        "SE": "sudeste", "SSE": "sul", "S": "sul", "SSW": "sul", "SW": "sudoeste", "WSW": "oeste",
        "W": "oeste", "WNW": "oeste", "NW": "noroeste", "NNW": "norte"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "muito alto" : uv >= 6 ? "alto" : uv >= 3 ? "moderado" : "baixo"
      phase: (phase, lit) => get({
        "New Moon": "lua nova", "Waxing Crescent": "crescente", "First Quarter": "quarto crescente",
        "Waxing Gibbous": "crescente gibosa", "Full Moon": "lua cheia", "Waning Gibbous": "minguante gibosa",
        "Last Quarter": "quarto minguante", "Waning Crescent": "minguante"
      }, phase, lower(phase)) + " · ${lit}% iluminada"
      dew: "ponto de orvalho"; gust: "rajadas"; clouds: "nuvens"; lowCloud: "baixas"; midCloud: "médias"; highCloud: "altas"; dewShort: "orvalho"
      windWord: "vento"; surface: "superfície"; uvMax: "uv máx"; clearSky: "céu limpo"; max: "máx"
      daylight: "luz do dia"; sunshine: "sol"; air: "qualidade do ar"; pollen: "pólen"; airShort: "ar"
      grass: "gramíneas"; birch: "bétula"; ragweed: "ambrosia"; olive: "oliveira"; mugwort: "artemísia"; alder: "amieiro"
      solar: "solar"; evap: "evaporação"; freeze: "congelamento"; unstable: "instabilidade"; bulb: "bulbo úmido"
      snow: "neve"; total: "total"; next2h: "próximas 2 horas"; nextFull: "próxima cheia"; nextNew: "próxima nova"; more: "mais dados"
      rainNow: "chovendo agora"; rainIn: m => "chuva em ${m} min"; rainStops: m => "a chuva para em ${m} min"; dryNext: h => "seco ${h} h"
      pollenLevel: v => v >= 200 ? "muito alto" : v >= 50 ? "alto" : v >= 10 ? "moderado" : "baixo"
      aqiLevel: a => a <= 50 ? "boa" : a <= 100 ? "moderada" : a <= 150 ? "ruim para alguns" : a <= 200 ? "ruim" : a <= 300 ? "muito ruim" : "perigosa"
    }
    de {
      title: "wetter"; loading: "wetter…"; offline: "wetter offline"; city: "stadt · leer = auto"
      feels: "gefühlt"; humidity: "luftfeuchte"; rainToday: "regen heute"; uv: "uv-index"; pressure: "luftdruck"
      visibility: "sichtweite"; next24: "nächste 24 stunden"; now: "jetzt"; days: "3 tage"; today: "heute"
      sunrise: "aufgang"; sunset: "untergang"; moon: "mond"; kmh: "km/h"; yr: "yr.no öffnen ↗"
      sky: code => get({
        "0": "klar", "1": "überwiegend klar", "2": "teils bewölkt", "3": "bedeckt",
        "45": "nebel", "48": "gefrierender nebel", "51": "leichter niesel", "53": "niesel",
        "55": "starker niesel", "56": "gefrierender niesel", "57": "starker gefrierender niesel", "61": "leichter regen",
        "63": "regen", "65": "starker regen", "66": "gefrierender regen", "67": "starker gefrierender regen",
        "71": "leichter schnee", "73": "schnee", "75": "starker schnee", "77": "schneegriesel",
        "80": "leichte regenschauer", "81": "regenschauer", "82": "starke regenschauer", "85": "leichte schneeschauer",
        "86": "schneeschauer", "95": "gewitter", "96": "gewitter mit hagel", "99": "starkes gewitter mit hagel"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => get({
        "N": "nordwind", "NNE": "nordwind", "NE": "nordostwind", "ENE": "ostwind", "E": "ostwind", "ESE": "ostwind",
        "SE": "südostwind", "SSE": "südwind", "S": "südwind", "SSW": "südwind", "SW": "südwestwind", "WSW": "westwind",
        "W": "westwind", "WNW": "westwind", "NW": "nordwestwind", "NNW": "nordwind"
      }, dir, "wind ${lower(dir)}")
      uvLevel: uv => uv >= 8 ? "sehr hoch" : uv >= 6 ? "hoch" : uv >= 3 ? "mäßig" : "niedrig"
      dew: "taupunkt"; gust: "böen"; clouds: "wolken"; lowCloud: "tief"; midCloud: "mittel"; highCloud: "hoch"; dewShort: "tau"
      windWord: "wind"; surface: "boden"; uvMax: "uv max"; clearSky: "klarer himmel"; max: "max"
      daylight: "tageslicht"; sunshine: "sonnenschein"; air: "luftqualität"; pollen: "pollen"; airShort: "luft"
      grass: "gräser"; birch: "birke"; ragweed: "ambrosia"; olive: "olive"; mugwort: "beifuß"; alder: "erle"
      solar: "solar"; evap: "verdunstung"; freeze: "frost"; unstable: "labilität"; bulb: "kühlgrenze"
      snow: "schnee"; total: "gesamt"; next2h: "nächste 2 stunden"; nextFull: "nächster vollmond"; nextNew: "nächster neumond"; more: "mehr werte"
      rainNow: "regen jetzt"; rainIn: m => "regen in ${m} min"; rainStops: m => "regen endet in ${m} min"; dryNext: h => "trocken ${h} h"
      pollenLevel: v => v >= 200 ? "sehr hoch" : v >= 50 ? "hoch" : v >= 10 ? "mäßig" : "niedrig"
      aqiLevel: a => a <= 50 ? "gut" : a <= 100 ? "mäßig" : a <= 150 ? "ungesund für empfindliche" : a <= 200 ? "ungesund" : a <= 300 ? "sehr ungesund" : "gefährlich"
      phase: (phase, lit) => get({
        "New Moon": "neumond", "Waxing Crescent": "zunehmende sichel", "First Quarter": "erstes viertel",
        "Waxing Gibbous": "zunehmender mond", "Full Moon": "vollmond", "Waning Gibbous": "abnehmender mond",
        "Last Quarter": "letztes viertel", "Waning Crescent": "abnehmende sichel"
      }, phase, lower(phase)) + " · ${lit}% beleuchtet"
    }
    zh {
      title: "天气"; loading: "天气…"; offline: "获取不到天气"; city: "城市 · 留空 = 自动"
      feels: "体感"; humidity: "湿度"; rainToday: "今日降水"; uv: "紫外线指数"; pressure: "气压"
      visibility: "能见度"; next24: "未来 24 小时"; now: "现在"; days: "未来 3 天"; today: "今天"
      sunrise: "日出"; sunset: "日落"; moon: "月亮"; kmh: "km/h"; yr: "打开 yr.no ↗"
      sky: code => get({
        "0": "晴", "1": "大部晴朗", "2": "局部多云", "3": "阴",
        "45": "雾", "48": "冻雾", "51": "小毛毛雨", "53": "毛毛雨",
        "55": "强毛毛雨", "56": "冻毛毛雨", "57": "强冻毛毛雨", "61": "小雨",
        "63": "中雨", "65": "大雨", "66": "冻雨", "67": "强冻雨",
        "71": "小雪", "73": "中雪", "75": "大雪", "77": "米雪",
        "80": "小阵雨", "81": "阵雨", "82": "强阵雨", "85": "小阵雪",
        "86": "阵雪", "95": "雷暴", "96": "雷暴伴冰雹", "99": "强雷暴伴冰雹"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => get({
        "N": "北风", "NNE": "北风", "NE": "东北风", "ENE": "东风", "E": "东风", "ESE": "东风",
        "SE": "东南风", "SSE": "南风", "S": "南风", "SSW": "南风", "SW": "西南风", "WSW": "西风",
        "W": "西风", "WNW": "西风", "NW": "西北风", "NNW": "北风"
      }, dir, "风向 ${dir}")
      uvLevel: uv => uv >= 8 ? "很强" : uv >= 6 ? "强" : uv >= 3 ? "中等" : "弱"
      dew: "露点"; gust: "阵风"; clouds: "云量"; lowCloud: "低云"; midCloud: "中云"; highCloud: "高云"; dewShort: "露点"
      windWord: "风"; surface: "地面"; uvMax: "紫外线峰值"; clearSky: "晴天值"; max: "最高"
      daylight: "白昼"; sunshine: "日照"; air: "空气质量"; pollen: "花粉"; airShort: "空气"
      grass: "禾草"; birch: "桦树"; ragweed: "豚草"; olive: "橄榄"; mugwort: "艾蒿"; alder: "桤木"
      solar: "太阳辐射"; evap: "蒸发"; freeze: "冻结"; unstable: "不稳定能量"; bulb: "湿球"
      snow: "积雪"; total: "合计"; next2h: "未来 2 小时"; nextFull: "下次满月"; nextNew: "下次新月"; more: "更多数据"
      rainNow: "正在下雨"; rainIn: m => "${m} 分钟后下雨"; rainStops: m => "${m} 分钟后雨停"; dryNext: h => "${h} 小时无雨"
      pollenLevel: v => v >= 200 ? "很高" : v >= 50 ? "高" : v >= 10 ? "中" : "低"
      aqiLevel: a => a <= 50 ? "优" : a <= 100 ? "良" : a <= 150 ? "敏感人群不健康" : a <= 200 ? "不健康" : a <= 300 ? "很不健康" : "危险"
      phase: (phase, lit) => get({
        "New Moon": "新月", "Waxing Crescent": "蛾眉月", "First Quarter": "上弦月",
        "Waxing Gibbous": "盈凸月", "Full Moon": "满月", "Waning Gibbous": "亏凸月",
        "Last Quarter": "下弦月", "Waning Crescent": "残月"
      }, phase, lower(phase)) + " · 照亮 ${lit}%"
    }
  }

  source now = clock every 1m
  // The date on two lines with the forecast row under it needs about 195dp; a 3x3 squeezed by an extra row
  // (190 on a Pixel 9a) cut the forecast off.
  let short = tileHeight != null && tileHeight < 200
  // A low tile (two rows on a phone) has no room for the days ahead; a narrow one (two columns) drops sunrise and sunset.
  let low = tileHeight != null && tileHeight < 150
  let narrow = tileWidth != null && tileWidth < 170
  state city = "" persist
  // Blank follows the country. A tap on the degree letter stores C or F.
  state unitChoice = "" persist
  // Blank follows the country: ipwho.is locates the phone by IP, otherwise Open-Meteo's geocoder finds the city.
  let byIp = trim(city) == ""
  // The city is a value in this URL, so it goes through enc(): "/", "?", "&" or "#" can't break it.
  source ipGeo = http(byIp ? "https://ipwho.is/" : null) every 30m timeout 10s json
  source cityGeo = http(byIp ? null : "https://geocoding-api.open-meteo.com/v1/search?name=${enc(trim(city))}&count=1&language=${enc(lang())}&format=json") every 30m timeout 10s json
  let geo = byIp ? ipGeo : cityGeo
  let where = geo == null ? null : byIp ? geo : geo.results[0]
  let lat = where == null ? null : where.latitude
  let lon = where == null ? null : where.longitude
  let place = where == null ? null : (where.name ?? where.city)
  let country = where == null ? null : where.country
  let countryCode = (where == null ? "" : where.country_code) ?? ""
  let autoImperial = contains(["US", "LR", "MM"], upper(countryCode))
  let imperial = unitChoice == "F" ? true : unitChoice == "C" ? false : autoImperial
  let unit = imperial ? "F" : "C"
  // One request, in the unit asked for, so the field names stay the same when °C/°F is tapped.
  source wx = http(lat == null || lon == null ? null : "https://api.open-meteo.com/v1/forecast?latitude=${fixed(lat, 4)}&longitude=${fixed(lon, 4)}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,rain,showers,snowfall,weather_code,cloud_cover,pressure_msl,surface_pressure,wind_speed_10m,wind_direction_10m,wind_gusts_10m,dew_point_2m,visibility&hourly=temperature_2m,precipitation_probability,weather_code,is_day,uv_index,visibility,dew_point_2m,apparent_temperature,cloud_cover,cloud_cover_low,cloud_cover_mid,cloud_cover_high,wind_speed_10m,wind_gusts_10m,cape,freezing_level_height,sunshine_duration,shortwave_radiation,wet_bulb_temperature_2m,vapour_pressure_deficit,snow_depth,rain,snowfall&daily=weather_code,temperature_2m_max,temperature_2m_min,apparent_temperature_max,apparent_temperature_min,sunrise,sunset,daylight_duration,sunshine_duration,uv_index_max,uv_index_clear_sky_max,precipitation_probability_max,precipitation_sum,precipitation_hours,snowfall_sum,wind_speed_10m_max,wind_gusts_10m_max,wind_direction_10m_dominant,shortwave_radiation_sum,et0_fao_evapotranspiration&minutely_15=precipitation,rain,snowfall,weather_code&forecast_minutely_15=16&timezone=auto&forecast_days=4&temperature_unit=${enc(imperial ? "fahrenheit" : "celsius")}&wind_speed_unit=${enc(imperial ? "mph" : "kmh")}&precipitation_unit=${enc(imperial ? "inch" : "mm")}") every 30m timeout 10s json status
  // Air quality and pollen are a second service, at the same coordinates.
  source air = http(lat == null || lon == null ? null : "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${fixed(lat, 4)}&longitude=${fixed(lon, 4)}&current=european_aqi,us_aqi,pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,sulphur_dioxide,ozone,dust,grass_pollen,birch_pollen,ragweed_pollen,olive_pollen,mugwort_pollen,alder_pollen&timezone=auto") every 1h timeout 10s json status
  let cur = wx == null || !wx.ok ? null : wx.out.current
  let daily = wx == null || !wx.ok ? null : wx.out.daily
  let hourly = wx == null || !wx.ok ? null : wx.out.hourly
  let wxFailed = wx != null && !wx.ok
  // The forecast's first hourly entry is today at 00:00, so the current hour is its index.
  let hi = cur == null ? 0 : num(sub(cur.time, 11, 13))
  let night = cur == null ? false : num(cur.is_day) == 0
  let code = cur == null ? null : cur.weather_code
  // Clear or partly cloudy gets a warm sun or a cool moon; everything else stays neutral.
  let sky = code == null ? foreground : code <= 2 ? (night ? blue : yellow) : foreground
  // Sunrise and sunset come as the location's local time, "2026-11-02T07:04"; show 24-hour time.
  let sun = daily == null ? ["", ""] : [daily.sunrise[0], daily.sunset[0]].map(t => t == null ? "" : sub(t, 11, 16))
  // Wind comes in degrees; name it the way the languages' wind strings expect.
  let dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
  let windDir = cur == null ? null : dirs[int((num(cur.wind_direction_10m) + 11.25) / 22.5) % 16]
  // The next 24 hours in 3-hour steps from the current hour.
  let steps = hourly == null ? [] : range(8).map(i => {
    hr: num(sub(hourly.time[hi + i * 3], 11, 13)),
    t: num(hourly.temperature_2m[hi + i * 3]),
    rain: num(hourly.precipitation_probability[hi + i * 3]),
    code: hourly.weather_code[hi + i * 3],
    night: num(hourly.is_day[hi + i * 3]) == 0,
    cloud: num(hourly.cloud_cover[hi + i * 3], 0),
    wind: num(hourly.wind_speed_10m[hi + i * 3], 0),
    gust: num(hourly.wind_gusts_10m[hi + i * 3], 0)
  })
  // The three days' range, so their bars share one scale.
  let lowest = daily == null ? 0 : min(take(daily.temperature_2m_min, 3))
  let highest = daily == null ? 0 : max(take(daily.temperature_2m_max, 3))
  // Open-Meteo's WMO codes, as omarchy's weather glyphs, day and night.
  let dayIcons = {
    "0": "", "1": "", "2": "", "3": "",
    "45": "", "48": "",
    "51": "", "53": "", "55": "",
    "56": "", "57": "",
    "61": "", "63": "", "65": "",
    "66": "", "67": "",
    "71": "", "73": "", "75": "", "77": "",
    "80": "", "81": "", "82": "",
    "85": "", "86": "",
    "95": "", "96": "", "99": ""
  }
  let nightIcons = {
    "0": "", "1": "", "2": "", "3": "",
    "45": "", "48": "",
    "51": "", "53": "", "55": "",
    "56": "", "57": "",
    "61": "", "63": "", "65": "",
    "66": "", "67": "",
    "71": "", "73": "", "75": "", "77": "",
    "80": "", "81": "", "82": "",
    "85": "", "86": "",
    "95": "", "96": "", "99": ""
  }
  let moonIcons = {
    "New Moon": "", "Waxing Crescent": "", "First Quarter": "", "Waxing Gibbous": "",
    "Full Moon": "", "Waning Gibbous": "", "Last Quarter": "", "Waning Crescent": ""
  }
  let uv = hourly == null ? 0 : num(hourly.uv_index[hi])
  // The moon's age from a known new moon (2000-01-06 18:14 UTC), in its 29.53-day cycle.
  let moonAge = ((now - 947182440) % 2551442.976) / 2551442.976
  let moonLit = round((1 - cos(2 * 3.141592653589793 * moonAge)) / 2 * 100)
  let moonPhase = moonAge < 0.0625 || moonAge >= 0.9375 ? "New Moon" : moonAge < 0.1875 ? "Waxing Crescent" : moonAge < 0.3125 ? "First Quarter" : moonAge < 0.4375 ? "Waxing Gibbous" : moonAge < 0.5625 ? "Full Moon" : moonAge < 0.6875 ? "Waning Gibbous" : moonAge < 0.8125 ? "Last Quarter" : "Waning Crescent"
  // The next full and new moon, from the same cycle: the days until the age reaches a half and a whole.
  let nextFull = fmtTime(now + max((0.5 - moonAge) % 1, 0.03) * 29.530588 * 86400, "d MMM")
  let nextNew = fmtTime(now + max((1 - moonAge) % 1, 0.03) * 29.530588 * 86400, "d MMM")
  // The next two hours in quarter-hours, from the nowcast: when rain starts or stops, and how much is coming.
  let mins = wx == null || !wx.ok ? null : wx.out.minutely_15
  let mp = mins == null ? [] : mins.precipitation.map(v => num(v, 0))
  let wetAt = len(mp) == 0 ? null : find(range(len(mp)), i => mp[i] > 0)
  let raining = len(mp) > 0 && mp[0] > 0
  let dryAt = raining ? find(range(len(mp)), i => mp[i] == 0) : null
  let rainAhead = sum(mp)
  let nowcast = len(mp) == 0 ? null : raining ? (dryAt == null ? str.rainNow : str.rainStops(dryAt * 15)) : wetAt == null ? str.dryNext(round(len(mp) * 15 / 60)) : str.rainIn(wetAt * 15)
  // Air quality and pollen; pollen is null outside the places Open-Meteo forecasts it for.
  let aq = air == null || !air.ok ? null : air.out.current
  let aqi = aq == null ? null : num(aq.us_aqi)
  let aqiColor = aqi == null ? muted : aqi <= 50 ? green : aqi <= 100 ? yellow : aqi <= 150 ? orange : red
  let pollenAll = aq == null ? [] : [
    { name: str.grass, v: aq.grass_pollen },
    { name: str.birch, v: aq.birch_pollen },
    { name: str.ragweed, v: aq.ragweed_pollen },
    { name: str.olive, v: aq.olive_pollen },
    { name: str.mugwort, v: aq.mugwort_pollen },
    { name: str.alder, v: aq.alder_pollen }
  ].map(p => { name: p.name, v: p.v == null ? null : round(num(p.v, 0)) })
  // The worst pollens first, for the card; the rest go on a line of their own.
  let pollens = pollenAll.filter(p => p.v != null).sortBy(p => -p.v)
  // Everything else the tile and the screen show, from the forecast already here.
  let unitShort = imperial ? "mph" : str.kmh
  let dewPt = cur == null ? null : num(cur.dew_point_2m)
  let cloudPct = cur == null ? null : num(cur.cloud_cover)
  let gust = cur == null ? null : num(cur.wind_gusts_10m)
  let surfaceP = cur == null ? null : num(cur.surface_pressure)
  let uvMax = daily == null ? null : num(daily.uv_index_max[0])
  let uvClear = daily == null ? null : num(daily.uv_index_clear_sky_max[0])
  let feelsHi = daily == null ? null : round(num(daily.apparent_temperature_max[0]))
  let feelsLo = daily == null ? null : round(num(daily.apparent_temperature_min[0]))
  let daylight = daily == null ? null : num(daily.daylight_duration[0])
  let sunshine = daily == null ? null : num(daily.sunshine_duration[0])
  let rainHours = daily == null ? null : num(daily.precipitation_hours[0])
  let windMax = daily == null ? null : num(daily.wind_speed_10m_max[0])
  let gustMax = daily == null ? null : num(daily.wind_gusts_10m_max[0])
  let windMain = daily == null ? null : dirs[int((num(daily.wind_direction_10m_dominant[0]) + 11.25) / 22.5) % 16]
  let solar = daily == null ? null : num(daily.shortwave_radiation_sum[0])
  let et0 = daily == null ? null : num(daily.et0_fao_evapotranspiration[0])
  let snowToday = daily == null ? null : num(daily.snowfall_sum[0])
  let cape = hourly == null ? null : num(hourly.cape[hi])
  let freezeAt = hourly == null ? null : num(hourly.freezing_level_height[hi])
  let bulb = hourly == null ? null : num(hourly.wet_bulb_temperature_2m[hi])
  let vpd = hourly == null ? null : num(hourly.vapour_pressure_deficit[hi])
  let snowDepth = hourly == null ? null : num(hourly.snow_depth[hi])
  let cloudLo = hourly == null ? null : num(hourly.cloud_cover_low[hi])
  let cloudMid = hourly == null ? null : num(hourly.cloud_cover_mid[hi])
  let cloudHi = hourly == null ? null : num(hourly.cloud_cover_high[hi])

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Stat(glyph, label, value, tint = foreground, sub = null) {
    Row {
      gap: 10
      align: center
      padding: [10, 8]
      border: 1
      borderColor: alpha(muted, 0.3)
      Text { text: glyph; font: icon; fontSize: 22; color: tint; width: 34; align: center }
      Column {
        gap: 0
        weight: 1
        Text { text: label; style: label; color: muted; maxLines: 1 }
        Text { text: value; style: body; maxLines: 1 }
        if sub != null {
          Text { text: sub; style: small; color: muted; maxLines: 1 }
        }
      }
    }
  }

  // One number and what it is, on the tile's own row.
  component Mini(label, value, tint = foreground) {
    Column {
      gap: 0
      weight: 1
      align: center
      Text { text: label; style: label; color: muted; maxLines: 1; align: center }
      Text { text: value; style: small; color: tint; maxLines: 1; align: center }
    }
  }

  // A line of the screen's own for a number too long for a card.
  component Detail(label, value) {
    Row {
      gap: 12
      align: center
      Text { text: label; style: small; color: muted; width: 118; maxLines: 1 }
      Text { text: value; style: small; weight: 1; align: end; maxLines: 2 }
    }
  }

  Column {
    gap: 0
    // A short tile (a 3x3 on the landscape home screen) gets the date on one line, so the forecast row still fits,
    // and so does a narrow one, where the month won't fit beside the big day.
    if short || narrow {
      Row {
        gap: 6
        align: center
        Text { text: fmtTime(now, "d"); fontSize: 24; width: 34; maxLines: 1 }
        Text { text: lower(fmtTime(now, "EEEE")); fontSize: 15; color: accent; weight: 1; maxLines: 1 }
        if !narrow {
          Text { text: lower(fmtTime(now, "MMMM")); fontSize: 13; color: muted; width: 90; align: end; maxLines: 1 }
        }
      }
    } else {
      Row {
        gap: 10
        align: center
        Text { text: fmtTime(now, "d"); fontSize: 52; width: 76; maxLines: 1 }
        Column {
          gap: 2
          weight: 1
          Text { text: lower(fmtTime(now, "EEEE")); fontSize: 20; color: accent; maxLines: 1 }
          Text { text: lower(fmtTime(now, "MMMM yyyy")); fontSize: 15; color: muted; maxLines: 1 }
        }
      }
    }
    Spacer { weight: 1 }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    Spacer { height: 8 }
    if cur != null {
      Row {
        gap: 6
        align: bottom
        Text { text: get(night ? nightIcons : dayIcons, "${int(code)}", ""); font: icon; fontSize: 26; color: sky; width: 22; padding: [0, 0, 0, 2] }
        Text { text: "${round(num(cur.temperature_2m))}°"; fontSize: 22; color: cyan; width: 56; maxLines: 1 }
        if !narrow {
          Column {
            gap: 0
            weight: 1
            Text { text: str.sky("${int(code)}"); style: small; align: end; maxLines: 1 }
            Text { text: "↑${round(num(daily.temperature_2m_max[0]))}° ↓${round(num(daily.temperature_2m_min[0]))}°"; style: small; color: muted; align: end; maxLines: 1; padding: [0, 0, 0, 5] }
          }
        }
      }
      Text { text: "${str.feels} ${round(num(cur.apparent_temperature))}° · ${lower(place)}"; style: small; color: muted; maxLines: 1 }
      // Rain in the next two hours, when there is any to mention.
      if nowcast != null && !low {
        Text { text: nowcast; style: small; color: raining ? cyan : muted; maxLines: 1 }
      }
      if !low {
        Spacer { weight: 1 }
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Spacer { height: 6 }
        // Wind, gusts, dew point, clouds and air, one small column each.
        Row {
          gap: 2
          Mini { label: str.windWord; value: "${round(num(cur.wind_speed_10m))} ${unitShort}" }
          if !narrow {
            Mini { label: str.gust; value: "${round(gust)} ${unitShort}" }
          }
          Mini { label: str.dewShort; value: "${round(dewPt)}°" }
          if !narrow {
            Mini { label: str.clouds; value: "${round(cloudPct)}%" }
          }
          if aqi != null {
            Mini { label: str.airShort; value: "${round(aqi)}"; tint: aqiColor }
          }
        }
        Spacer { weight: 1 }
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Spacer { height: 8 }
        // The next two days (icon from the day's own summary), then sunrise and sunset.
        // Each named from its own date: just after midnight, the forecast from before it still starts yesterday.
        Row {
          gap: 4
          align: center
          for i in take(drop(range(4), 1), 2) {
            Column {
              gap: 0
              weight: 1
              align: center
              Text { text: lower(fmtTime(parseTime(daily.time[i]), "EEE")); style: label; color: muted; align: center }
              Text { text: get(dayIcons, "${int(daily.weather_code[i])}", ""); font: icon; fontSize: 18; align: center }
              Text { text: "${round(num(daily.temperature_2m_max[i]))}° ${round(num(daily.temperature_2m_min[i]))}°"; style: small; align: center; maxLines: 1 }
            }
          }
          if !narrow {
            Column {
              gap: 4
              weight: 1.2
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: yellow; width: 28 }
                Text { text: sun[0]; style: small; maxLines: 1; weight: 1 }
              }
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: orange; width: 28 }
                Text { text: sun[1]; style: small; maxLines: 1; weight: 1 }
              }
            }
          }
        }
      }
    } else {
      Text { text: (lat == null && geo != null) || wxFailed ? str.offline : str.loading; style: small; color: muted }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    if cur == null {
      Text { text: (lat == null && geo != null) || wxFailed ? str.offline : str.loading; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 14
        // Now.
        Row {
          gap: 16
          align: center
          Text { text: get(night ? nightIcons : dayIcons, "${int(code)}", ""); font: icon; fontSize: 64; color: sky; width: 80; align: center }
          Column {
            gap: 0
            weight: 1
            Text {
              text: "${round(num(cur.temperature_2m))}°${unit}"
              fontSize: 44
              color: cyan
              maxLines: 1
              onTap: unitChoice = unit == "C" ? "F" : "C"
            }
            Text { text: str.sky("${int(code)}"); style: body; maxLines: 2 }
          }
        }
        Text {
          text: "${str.feels} ${round(num(cur.apparent_temperature))}° (${feelsLo}°–${feelsHi}°) · ↑${round(num(daily.temperature_2m_max[0]))}° ↓${round(num(daily.temperature_2m_min[0]))}° · ${lower(place)}, ${lower(country)}"
          style: small
          color: muted
        }
        // Rain in the next hours, and how much of it.
        if nowcast != null {
          Row {
            gap: 8
            align: center
            Text { text: nowcast; style: body; color: raining ? cyan : accent; weight: 1; maxLines: 2 }
            if rainAhead > 0 {
              Text { text: "${str.total} ${fixed(rainAhead, 2)} ${imperial ? "in" : "mm"}"; style: small; color: muted; align: end }
            }
          }
        }
        Rule { }
        // Everything now, a card each.
        Grid {
          columns: 2
          gap: 8
          Stat { glyph: ""; label: str.windWord; value: "${round(num(cur.wind_speed_10m))} ${unitShort} ${lower(windDir ?? "")}"; tint: cyan; sub: "${str.gust} ${round(gust)}" }
          Stat { glyph: ""; label: str.humidity; value: "${round(num(cur.relative_humidity_2m))}%"; tint: blue; sub: "${str.dew} ${round(dewPt)}°" }
          Stat { glyph: ""; label: str.rainToday; value: "${round(num(daily.precipitation_probability_max[0]))}%"; tint: blue; sub: "${fixed(num(daily.precipitation_sum[0]), 1)} ${imperial ? "in" : "mm"} · ${round(rainHours)} h" }
          Stat { glyph: ""; label: str.uv; value: "${round(uv)} ${str.uvLevel(uv)}"; tint: uv >= 6 ? red : uv >= 3 ? yellow : green; sub: "${str.uvMax} ${round(uvMax)}" }
          Stat { glyph: ""; label: str.pressure; value: imperial ? "${fixed(num(cur.pressure_msl) * 0.02953, 2)} inHg" : "${round(num(cur.pressure_msl))} hPa"; sub: "${str.surface} ${imperial ? fixed(surfaceP * 0.02953, 2) : round(surfaceP)}" }
          Stat { glyph: ""; label: str.visibility; value: imperial ? "${fixed(num(hourly.visibility[hi]) / 1609.344, 1)} mi" : "${fixed(num(hourly.visibility[hi]) / 1000, 1)} km"; sub: "${str.clouds} ${round(cloudPct)}%" }
          if aqi != null {
            Stat { glyph: ""; label: str.air; value: "${round(aqi)} ${str.aqiLevel(aqi)}"; tint: aqiColor; sub: "pm2.5 ${fixed(num(aq.pm2_5), 1)}" }
          }
          if len(pollens) > 0 {
            Stat { glyph: ""; label: str.pollen; value: "${pollens[0].name} ${pollens[0].v}"; tint: green; sub: "${str.pollenLevel(pollens[0].v)}" }
          }
        }
        Rule { }
        // The rest, a line each.
        Text { text: str.more; style: label; color: accent }
        Column {
          gap: 6
          Detail { label: str.clouds; value: "${str.lowCloud} ${round(cloudLo)}% · ${str.midCloud} ${round(cloudMid)}% · ${str.highCloud} ${round(cloudHi)}%" }
          Detail { label: str.windWord; value: "${str.max} ${round(windMax)} ${unitShort} · ${lower(windMain ?? "")}" }
          Detail { label: str.gust; value: "${str.now} ${round(gust)} · ${str.max} ${round(gustMax)} ${unitShort}" }
          Detail { label: str.uvMax; value: "${round(uvMax)} · ${str.clearSky} ${round(uvClear)}" }
          Detail { label: str.solar; value: "${fixed(solar, 1)} MJ/m² · et₀ ${fixed(et0, 1)} mm" }
          Detail { label: str.unstable; value: "${round(cape)} J/kg · ${str.freeze} ${round(freezeAt)} m" }
          Detail { label: str.bulb; value: "${fixed(bulb, 1)}° · vpd ${fixed(vpd, 2)} kPa" }
          if aq != null {
            Detail { label: str.air; value: "pm2.5 ${fixed(num(aq.pm2_5), 1)} · pm10 ${fixed(num(aq.pm10), 1)} · co ${round(num(aq.carbon_monoxide))}" }
            Detail { label: "o₃ · no₂ · so₂"; value: "${round(num(aq.ozone))} · ${fixed(num(aq.nitrogen_dioxide), 1)} · ${fixed(num(aq.sulphur_dioxide), 1)}" }
          }
          if len(pollenAll) > 0 {
            Detail { label: str.pollen; value: "${join(pollenAll.map(p => p.name + " " + (p.v == null ? "—" : p.v)), " · ")}" }
          }
          if snowDepth > 0 || snowToday > 0 {
            Detail { label: str.snow; value: "${round(snowDepth * 100)} cm · ${str.today} ${fixed(snowToday, 1)} cm" }
          }
        }
        Rule { }
        // The next 24 hours: time, icon and rain chance per step, with the temperature curve under them.
        Text { text: str.next24; style: label; color: accent }
        Column {
          gap: 4
          Row {
            gap: 0
            for s, i in steps key s.hr {
              Column {
                gap: 2
                weight: 1
                align: center
                Text { text: i == 0 ? str.now : pad(s.hr, 2, "0"); style: label; color: muted; align: center }
                Text { text: get(s.night ? nightIcons : dayIcons, "${int(s.code)}", ""); font: icon; fontSize: 20; align: center }
              }
            }
          }
          Canvas {
            height: 84
            fill: width
            let n = max(len(steps), 1)
            let temps = steps.map(s => s.t)
            let lo = min(temps)
            let hi = max(temps)
            let ys = temps.map(t => 22 + (hi - t) / max(hi - lo, 1) * 26)
            let xs = range(n).map(i => (i + 0.5) * width / n)
            path(range(n).map(i => [xs[i], ys[i]]), stroke: accent, width: 2)
            for s, i in steps {
              circle(xs[i], ys[i], 3, fill: accent)
              text("${round(s.t)}°", xs[i], ys[i] - 13, size: 12, align: center, color: foreground)
              rect(xs[i] - 10, height - 12, 20, 4, radius: 2, fill: alpha(muted, 0.2))
              rect(xs[i] - 10, height - 12, 20 * s.rain / 100, 4, radius: 2, fill: blue)
              text("${s.rain}%", xs[i], height - 24, size: 10, align: center, color: s.rain >= 30 ? blue : muted)
            }
          }
          // The same stretch's clouds, then its wind as a line and its gusts above it.
          if len(steps) > 0 {
            Text { text: str.clouds; style: label; color: muted; padding: [8, 0, 0, 0] }
            Canvas {
              height: 40
              fill: width
              let n = max(len(steps), 1)
              let xs = range(n).map(i => (i + 0.5) * width / n)
              let ys = steps.map(s => height - 8 - s.cloud / 100 * (height - 18))
              let pts = range(n + 2).map(i => i == 0 ? [0, height] : i == n + 1 ? [width, height] : [xs[i - 1], ys[i - 1]])
              path(pts, closed: true, fill: alpha(blue, 0.12))
              path(xs.map((x, i) => [x, ys[i]]), stroke: blue, width: 1)
              line(0, height - 8 - (height - 18) / 2, width, height - 8 - (height - 18) / 2, stroke: alpha(muted, 0.2))
            }
            Canvas {
              height: 46
              fill: width
              let n = max(len(steps), 1)
              let xs = range(n).map(i => (i + 0.5) * width / n)
              let top = max(max(steps.map(s => s.gust)), 1)
              let wy = steps.map(s => height - 10 - s.wind / top * (height - 26))
              let gy = steps.map(s => height - 10 - s.gust / top * (height - 26))
              path(xs.map((x, i) => [x, wy[i]]), stroke: cyan, width: 2)
              path(xs.map((x, i) => [x, gy[i]]), stroke: orange, width: 1)
              text("${str.windWord} ${round(num(cur.wind_speed_10m))} ${unitShort}", 2, 8, size: 10, align: start, color: cyan)
              text("${str.gust} ${round(gustMax)} ${unitShort}", width - 2, 8, size: 10, align: end, color: orange)
            }
          }
        }
        // Only when rain is actually coming: a bar is how much each 15 minutes holds.
        if rainAhead > 0 {
          Rule { }
          Text { text: str.next2h; style: label; color: accent }
          Canvas {
            height: 78
            fill: width
            let n = max(len(mp), 1)
            let peak = max(max(mp), 0.05)
            for v, i in mp {
              let bw = width / n
              let h = max(v, 0) / peak * (height - 34)
              rect(i * bw + 1, height - 20 - h, bw - 2, h, radius: 2, fill: v > 0 ? blue : alpha(muted, 0.18))
              rect(i * bw + 1, height - 20, bw - 2, 2, radius: 1, fill: alpha(muted, 0.25))
              if i % 4 == 0 {
                text(sub(mins.time[i], 11, 16), i * bw + bw / 2, height - 8, size: 10, align: center, color: muted)
              }
            }
          }
        }
        Rule { }
        // Three days: icon, rain chance and the day's low to high on a shared scale.
        Text { text: str.days; style: label; color: accent }
        for i in range(3) {
          let lo = round(num(daily.temperature_2m_min[i]))
          let hi = round(num(daily.temperature_2m_max[i]))
          Row {
            gap: 8
            align: center
            Text { text: i == 0 ? str.today : lower(fmtTime(parseTime(daily.time[i]), "EEE")); style: body; width: 64; maxLines: 1 }
            Text { text: get(dayIcons, "${int(daily.weather_code[i])}", ""); font: icon; fontSize: 20; width: 26; align: center }
            Text { text: "${round(num(daily.precipitation_probability_max[i]))}%"; style: small; color: blue; width: 40; align: end; maxLines: 1 }
            Text { text: "${lo}°"; style: small; color: muted; width: 36; align: end; maxLines: 1 }
            Canvas {
              height: 6
              weight: 1
              let span = max(highest - lowest, 1)
              let x0 = (lo - lowest) / span * width
              let x1 = (hi - lowest) / span * width
              rect(0, 0, width, height, radius: 3, fill: alpha(muted, 0.2))
              rect(x0, 0, max(x1 - x0, 6), height, radius: 3, fill: linear(0, 0, width, 0, [cyan, orange]))
            }
            Text { text: "${hi}°"; style: small; width: 36; maxLines: 1 }
          }
        }
        Rule { }
        // Sun and moon.
        Row {
          gap: 8
          Stat { glyph: ""; label: str.sunrise; value: sun[0]; tint: yellow; weight: 1 }
          Stat { glyph: ""; label: str.sunset; value: sun[1]; tint: orange; weight: 1 }
        }
        Row {
          gap: 8
          Stat { glyph: ""; label: str.daylight; value: fmtDuration(daylight); tint: yellow; weight: 1 }
          Stat { glyph: ""; label: str.sunshine; value: fmtDuration(sunshine); tint: orange; weight: 1 }
        }
        Stat {
          glyph: get(moonIcons, moonPhase, "")
          label: str.moon
          value: str.phase(moonPhase, moonLit)
          tint: foreground
        }
        Row {
          gap: 8
          Stat { glyph: ""; label: str.nextFull; value: nextFull; weight: 1 }
          Stat { glyph: ""; label: str.nextNew; value: nextNew; weight: 1 }
        }
        // yr.no (Norwegian Meteorological Institute): ad-free and worldwide, opened at the forecast's coordinates.
        Row {
          justify: end
          Button { text: str.yr; color: muted; onTap: url("https://www.yr.no/en/forecast/daily-table/${fixed(lat, 4)},${fixed(lon, 4)}") }
        }
      }
    }
  }
}
