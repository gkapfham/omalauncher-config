widget "today" {
  page: 1
  order: 1
  size: 3x3
  minSize: 2x2
  meta { description: "The date and the weather where you are, by IP or a city you type. Tap it for the next 24 hours, three days, wind, UV, sun and moon. Tap °C or °F to switch"; version: "1.8"; license: "MIT"; category: "world"; owl: 16 }

  // What it says, in the phone's language where it has a set. The sky comes from Open-Meteo's WMO code and the
  // moon from its phase, named in each language here rather than by the API.
  strings {
    en {
      title: "weather"; loading: "weather…"; offline: "weather offline"; city: "city · empty = auto"
      feels: "feels"; humidity: "humidity"; rainToday: "rain today"; uv: "uv index"; pressure: "pressure"
      visibility: "visibility"; next24: "next 24 hours"; now: "now"; days: "3 days"; today: "today"
      sunrise: "sunrise"; sunset: "sunset"; moon: "moon"; kmh: "km/h"; yr: "open yr.no ↗"
      sky: code => get({
        "0": "clear", "1": "mainly clear", "2": "partly cloudy", "3": "overcast",
        "45": "fog", "48": "freezing fog", "51": "light drizzle", "53": "drizzle",
        "55": "heavy drizzle", "56": "freezing drizzle", "57": "heavy freezing drizzle", "61": "light rain",
        "63": "rain", "65": "heavy rain", "66": "freezing rain", "67": "heavy freezing rain",
        "71": "light snow", "73": "snow", "75": "heavy snow", "77": "snow grains",
        "80": "light showers", "81": "showers", "82": "heavy showers", "85": "light snow showers",
        "86": "snow showers", "95": "thunderstorm", "96": "thunderstorm with hail", "99": "heavy thunderstorm with hail"
      }, code, "")
      wind: dir => "wind ${lower(dir)}"
      uvLevel: uv => uv >= 8 ? "very high" : uv >= 6 ? "high" : uv >= 3 ? "moderate" : "low"
      phase: (phase, lit) => "${lower(phase)} · ${lit}% lit"
    }
    id {
      title: "cuaca"; loading: "cuaca…"; offline: "cuaca offline"; city: "kota · kosong = otomatis"
      feels: "terasa"; humidity: "kelembapan"; rainToday: "hujan hari ini"; uv: "indeks uv"; pressure: "tekanan"
      visibility: "jarak pandang"; next24: "24 jam ke depan"; now: "kini"; days: "3 hari"; today: "hari ini"
      sunrise: "terbit"; sunset: "terbenam"; moon: "bulan"; kmh: "km/jam"; yr: "buka yr.no ↗"
      sky: code => get({
        "0": "cerah", "1": "cerah berawan", "2": "cerah berawan", "3": "mendung",
        "45": "kabut", "48": "kabut beku", "51": "gerimis ringan", "53": "gerimis",
        "55": "gerimis lebat", "56": "gerimis beku", "57": "gerimis beku lebat", "61": "hujan ringan",
        "63": "hujan sedang", "65": "hujan lebat", "66": "hujan beku ringan", "67": "hujan beku lebat",
        "71": "salju ringan", "73": "salju sedang", "75": "salju lebat", "77": "butiran salju",
        "80": "hujan lokal", "81": "hujan sesaat", "82": "hujan deras sesaat", "85": "salju ringan sesaat",
        "86": "salju lebat sesaat", "95": "badai petir", "96": "badai petir dengan hujan es", "99": "badai petir lebat dengan hujan es"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "angin " + get({
        "N": "utara", "NNE": "utara", "NE": "timur laut", "ENE": "timur", "E": "timur", "ESE": "timur",
        "SE": "tenggara", "SSE": "selatan", "S": "selatan", "SSW": "selatan", "SW": "barat daya", "WSW": "barat",
        "W": "barat", "WNW": "barat", "NW": "barat laut", "NNW": "utara"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "sangat tinggi" : uv >= 6 ? "tinggi" : uv >= 3 ? "sedang" : "rendah"
      phase: (phase, lit) => get({
        "New Moon": "bulan baru", "Waxing Crescent": "sabit awal", "First Quarter": "kuartir pertama",
        "Waxing Gibbous": "cembung awal", "Full Moon": "purnama", "Waning Gibbous": "cembung akhir",
        "Last Quarter": "kuartir akhir", "Waning Crescent": "sabit akhir"
      }, phase, lower(phase)) + " · ${lit}% terang"
    }
    es {
      title: "clima"; loading: "clima…"; offline: "clima sin conexión"; city: "ciudad · vacío = auto"
      feels: "sensación"; humidity: "humedad"; rainToday: "lluvia hoy"; uv: "índice uv"; pressure: "presión"
      visibility: "visibilidad"; next24: "próximas 24 horas"; now: "ahora"; days: "3 días"; today: "hoy"
      sunrise: "amanecer"; sunset: "atardecer"; moon: "luna"; kmh: "km/h"; yr: "abrir yr.no ↗"
      sky: code => get({
        "0": "despejado", "1": "mayormente despejado", "2": "parcialmente nublado", "3": "cubierto",
        "45": "niebla", "48": "niebla helada", "51": "llovizna ligera", "53": "llovizna",
        "55": "llovizna fuerte", "56": "llovizna helada", "57": "llovizna helada fuerte", "61": "lluvia ligera",
        "63": "lluvia moderada", "65": "lluvia fuerte", "66": "lluvia helada ligera", "67": "lluvia helada fuerte",
        "71": "nevada ligera", "73": "nevada moderada", "75": "nevada fuerte", "77": "granos de nieve",
        "80": "chubascos ligeros", "81": "chubascos", "82": "chubascos fuertes", "85": "chubascos de nieve ligeros",
        "86": "chubascos de nieve fuertes", "95": "tormenta eléctrica", "96": "tormenta con granizo", "99": "tormenta fuerte con granizo"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "viento del " + get({
        "N": "norte", "NNE": "norte", "NE": "noreste", "ENE": "este", "E": "este", "ESE": "este",
        "SE": "sureste", "SSE": "sur", "S": "sur", "SSW": "sur", "SW": "suroeste", "WSW": "oeste",
        "W": "oeste", "WNW": "oeste", "NW": "noroeste", "NNW": "norte"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "muy alto" : uv >= 6 ? "alto" : uv >= 3 ? "moderado" : "bajo"
      phase: (phase, lit) => get({
        "New Moon": "luna nueva", "Waxing Crescent": "creciente", "First Quarter": "cuarto creciente",
        "Waxing Gibbous": "gibosa creciente", "Full Moon": "luna llena", "Waning Gibbous": "gibosa menguante",
        "Last Quarter": "cuarto menguante", "Waning Crescent": "menguante"
      }, phase, lower(phase)) + " · ${lit}% iluminada"
    }
    pt {
      title: "clima"; loading: "clima…"; offline: "clima offline"; city: "cidade · vazio = auto"
      feels: "sensação"; humidity: "umidade"; rainToday: "chuva hoje"; uv: "índice uv"; pressure: "pressão"
      visibility: "visibilidade"; next24: "próximas 24 horas"; now: "agora"; days: "3 dias"; today: "hoje"
      sunrise: "nascer do sol"; sunset: "pôr do sol"; moon: "lua"; kmh: "km/h"; yr: "abrir yr.no ↗"
      sky: code => get({
        "0": "céu limpo", "1": "pouco nublado", "2": "parcialmente nublado", "3": "encoberto",
        "45": "neblina", "48": "neblina congelante", "51": "garoa fraca", "53": "garoa",
        "55": "garoa forte", "56": "garoa congelante", "57": "garoa congelante forte", "61": "chuva fraca",
        "63": "chuva moderada", "65": "chuva forte", "66": "chuva congelante fraca", "67": "chuva congelante forte",
        "71": "neve fraca", "73": "neve moderada", "75": "neve forte", "77": "grãos de neve",
        "80": "pancadas de chuva fracas", "81": "pancadas de chuva", "82": "pancadas de chuva fortes", "85": "pancadas de neve fracas",
        "86": "pancadas de neve fortes", "95": "trovoada", "96": "trovoada com granizo", "99": "trovoada forte com granizo"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => "vento " + get({
        "N": "norte", "NNE": "norte", "NE": "nordeste", "ENE": "leste", "E": "leste", "ESE": "leste",
        "SE": "sudeste", "SSE": "sul", "S": "sul", "SSW": "sul", "SW": "sudoeste", "WSW": "oeste",
        "W": "oeste", "WNW": "oeste", "NW": "noroeste", "NNW": "norte"
      }, dir, lower(dir))
      uvLevel: uv => uv >= 8 ? "muito alto" : uv >= 6 ? "alto" : uv >= 3 ? "moderado" : "baixo"
      phase: (phase, lit) => get({
        "New Moon": "lua nova", "Waxing Crescent": "crescente", "First Quarter": "quarto crescente",
        "Waxing Gibbous": "crescente gibosa", "Full Moon": "lua cheia", "Waning Gibbous": "minguante gibosa",
        "Last Quarter": "quarto minguante", "Waning Crescent": "minguante"
      }, phase, lower(phase)) + " · ${lit}% iluminada"
    }
    de {
      title: "wetter"; loading: "wetter…"; offline: "wetter offline"; city: "stadt · leer = auto"
      feels: "gefühlt"; humidity: "luftfeuchte"; rainToday: "regen heute"; uv: "uv-index"; pressure: "luftdruck"
      visibility: "sichtweite"; next24: "nächste 24 stunden"; now: "jetzt"; days: "3 tage"; today: "heute"
      sunrise: "aufgang"; sunset: "untergang"; moon: "mond"; kmh: "km/h"; yr: "yr.no öffnen ↗"
      sky: code => get({
        "0": "klar", "1": "überwiegend klar", "2": "teils bewölkt", "3": "bedeckt",
        "45": "nebel", "48": "gefrierender nebel", "51": "leichter niesel", "53": "niesel",
        "55": "starker niesel", "56": "gefrierender niesel", "57": "starker gefrierender niesel", "61": "leichter regen",
        "63": "regen", "65": "starker regen", "66": "gefrierender regen", "67": "starker gefrierender regen",
        "71": "leichter schnee", "73": "schnee", "75": "starker schnee", "77": "schneegriesel",
        "80": "leichte regenschauer", "81": "regenschauer", "82": "starke regenschauer", "85": "leichte schneeschauer",
        "86": "schneeschauer", "95": "gewitter", "96": "gewitter mit hagel", "99": "starkes gewitter mit hagel"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => get({
        "N": "nordwind", "NNE": "nordwind", "NE": "nordostwind", "ENE": "ostwind", "E": "ostwind", "ESE": "ostwind",
        "SE": "südostwind", "SSE": "südwind", "S": "südwind", "SSW": "südwind", "SW": "südwestwind", "WSW": "westwind",
        "W": "westwind", "WNW": "westwind", "NW": "nordwestwind", "NNW": "nordwind"
      }, dir, "wind ${lower(dir)}")
      uvLevel: uv => uv >= 8 ? "sehr hoch" : uv >= 6 ? "hoch" : uv >= 3 ? "mäßig" : "niedrig"
      phase: (phase, lit) => get({
        "New Moon": "neumond", "Waxing Crescent": "zunehmende sichel", "First Quarter": "erstes viertel",
        "Waxing Gibbous": "zunehmender mond", "Full Moon": "vollmond", "Waning Gibbous": "abnehmender mond",
        "Last Quarter": "letztes viertel", "Waning Crescent": "abnehmende sichel"
      }, phase, lower(phase)) + " · ${lit}% beleuchtet"
    }
    zh {
      title: "天气"; loading: "天气…"; offline: "获取不到天气"; city: "城市 · 留空 = 自动"
      feels: "体感"; humidity: "湿度"; rainToday: "今日降水"; uv: "紫外线指数"; pressure: "气压"
      visibility: "能见度"; next24: "未来 24 小时"; now: "现在"; days: "未来 3 天"; today: "今天"
      sunrise: "日出"; sunset: "日落"; moon: "月亮"; kmh: "km/h"; yr: "打开 yr.no ↗"
      sky: code => get({
        "0": "晴", "1": "大部晴朗", "2": "局部多云", "3": "阴",
        "45": "雾", "48": "冻雾", "51": "小毛毛雨", "53": "毛毛雨",
        "55": "强毛毛雨", "56": "冻毛毛雨", "57": "强冻毛毛雨", "61": "小雨",
        "63": "中雨", "65": "大雨", "66": "冻雨", "67": "强冻雨",
        "71": "小雪", "73": "中雪", "75": "大雪", "77": "米雪",
        "80": "小阵雨", "81": "阵雨", "82": "强阵雨", "85": "小阵雪",
        "86": "阵雪", "95": "雷暴", "96": "雷暴伴冰雹", "99": "强雷暴伴冰雹"
      }, code, "")
      // Eight points: the sixteen's in-between ones go to the nearer of north, east, south and west.
      wind: dir => get({
        "N": "北风", "NNE": "北风", "NE": "东北风", "ENE": "东风", "E": "东风", "ESE": "东风",
        "SE": "东南风", "SSE": "南风", "S": "南风", "SSW": "南风", "SW": "西南风", "WSW": "西风",
        "W": "西风", "WNW": "西风", "NW": "西北风", "NNW": "北风"
      }, dir, "风向 ${dir}")
      uvLevel: uv => uv >= 8 ? "很强" : uv >= 6 ? "强" : uv >= 3 ? "中等" : "弱"
      phase: (phase, lit) => get({
        "New Moon": "新月", "Waxing Crescent": "蛾眉月", "First Quarter": "上弦月",
        "Waxing Gibbous": "盈凸月", "Full Moon": "满月", "Waning Gibbous": "亏凸月",
        "Last Quarter": "下弦月", "Waning Crescent": "残月"
      }, phase, lower(phase)) + " · 照亮 ${lit}%"
    }
  }

  source now = clock every 1m
  // The date on two lines with the forecast row under it needs about 195dp; a 3x3 squeezed by an extra row
  // (190 on a Pixel 9a) cut the forecast off.
  let short = tileHeight != null && tileHeight < 200
  // A low tile (two rows on a phone) has no room for the days ahead; a narrow one (two columns) drops sunrise and sunset.
  let low = tileHeight != null && tileHeight < 150
  let narrow = tileWidth != null && tileWidth < 170
  state city = "" persist
  // Blank follows the country. A tap on the degree letter stores C or F.
  state unitChoice = "" persist
  // Blank follows the country: ipwho.is locates the phone by IP, otherwise Open-Meteo's geocoder finds the city.
  let byIp = trim(city) == ""
  // The city is a value in this URL, so it goes through enc(): "/", "?", "&" or "#" can't break it.
  source ipGeo = http(byIp ? "https://ipwho.is/" : null) every 30m timeout 10s json
  source cityGeo = http(byIp ? null : "https://geocoding-api.open-meteo.com/v1/search?name=${enc(trim(city))}&count=1&language=${enc(lang())}&format=json") every 30m timeout 10s json
  let geo = byIp ? ipGeo : cityGeo
  let where = geo == null ? null : byIp ? geo : geo.results[0]
  let lat = where == null ? null : where.latitude
  let lon = where == null ? null : where.longitude
  let place = where == null ? null : (where.name ?? where.city)
  let country = where == null ? null : where.country
  let countryCode = (where == null ? "" : where.country_code) ?? ""
  let autoImperial = contains(["US", "LR", "MM"], upper(countryCode))
  let imperial = unitChoice == "F" ? true : unitChoice == "C" ? false : autoImperial
  let unit = imperial ? "F" : "C"
  // One request, in the unit asked for, so the field names stay the same when °C/°F is tapped.
  source wx = http(lat == null || lon == null ? null : "https://api.open-meteo.com/v1/forecast?latitude=${fixed(lat, 4)}&longitude=${fixed(lon, 4)}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,cloud_cover,pressure_msl,wind_speed_10m,wind_direction_10m,wind_gusts_10m&hourly=temperature_2m,precipitation_probability,weather_code,is_day,uv_index,visibility&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,uv_index_max,precipitation_probability_max,precipitation_sum&timezone=auto&forecast_days=4&temperature_unit=${enc(imperial ? "fahrenheit" : "celsius")}&wind_speed_unit=${enc(imperial ? "mph" : "kmh")}&precipitation_unit=${enc(imperial ? "inch" : "mm")}") every 30m timeout 10s json status
  let cur = wx == null || !wx.ok ? null : wx.out.current
  let daily = wx == null || !wx.ok ? null : wx.out.daily
  let hourly = wx == null || !wx.ok ? null : wx.out.hourly
  let wxFailed = wx != null && !wx.ok
  // The forecast's first hourly entry is today at 00:00, so the current hour is its index.
  let hi = cur == null ? 0 : num(sub(cur.time, 11, 13))
  let night = cur == null ? false : num(cur.is_day) == 0
  let code = cur == null ? null : cur.weather_code
  // Clear or partly cloudy gets a warm sun or a cool moon; everything else stays neutral.
  let sky = code == null ? foreground : code <= 2 ? (night ? blue : yellow) : foreground
  // Sunrise and sunset come as the location's local time, "2026-11-02T07:04"; show 24-hour time.
  let sun = daily == null ? ["", ""] : [daily.sunrise[0], daily.sunset[0]].map(t => t == null ? "" : sub(t, 11, 16))
  // Wind comes in degrees; name it the way the languages' wind strings expect.
  let dirs = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
  let windDir = cur == null ? null : dirs[int((num(cur.wind_direction_10m) + 11.25) / 22.5) % 16]
  // The next 24 hours in 3-hour steps from the current hour.
  let steps = hourly == null ? [] : range(8).map(i => {
    hr: num(sub(hourly.time[hi + i * 3], 11, 13)),
    t: num(hourly.temperature_2m[hi + i * 3]),
    rain: num(hourly.precipitation_probability[hi + i * 3]),
    code: hourly.weather_code[hi + i * 3],
    night: num(hourly.is_day[hi + i * 3]) == 0
  })
  // The three days' range, so their bars share one scale.
  let lowest = daily == null ? 0 : min(take(daily.temperature_2m_min, 3))
  let highest = daily == null ? 0 : max(take(daily.temperature_2m_max, 3))
  // Open-Meteo's WMO codes, as omarchy's weather glyphs, day and night.
  let dayIcons = {
    "0": "", "1": "", "2": "", "3": "",
    "45": "", "48": "",
    "51": "", "53": "", "55": "",
    "56": "", "57": "",
    "61": "", "63": "", "65": "",
    "66": "", "67": "",
    "71": "", "73": "", "75": "", "77": "",
    "80": "", "81": "", "82": "",
    "85": "", "86": "",
    "95": "", "96": "", "99": ""
  }
  let nightIcons = {
    "0": "", "1": "", "2": "", "3": "",
    "45": "", "48": "",
    "51": "", "53": "", "55": "",
    "56": "", "57": "",
    "61": "", "63": "", "65": "",
    "66": "", "67": "",
    "71": "", "73": "", "75": "", "77": "",
    "80": "", "81": "", "82": "",
    "85": "", "86": "",
    "95": "", "96": "", "99": ""
  }
  let moonIcons = {
    "New Moon": "", "Waxing Crescent": "", "First Quarter": "", "Waxing Gibbous": "",
    "Full Moon": "", "Waning Gibbous": "", "Last Quarter": "", "Waning Crescent": ""
  }
  let uv = hourly == null ? 0 : num(hourly.uv_index[hi])
  // The moon's age from a known new moon (2000-01-06 18:14 UTC), in its 29.53-day cycle.
  let moonAge = ((now - 947182440) % 2551442.976) / 2551442.976
  let moonLit = round((1 - cos(2 * 3.141592653589793 * moonAge)) / 2 * 100)
  let moonPhase = moonAge < 0.0625 || moonAge >= 0.9375 ? "New Moon" : moonAge < 0.1875 ? "Waxing Crescent" : moonAge < 0.3125 ? "First Quarter" : moonAge < 0.4375 ? "Waxing Gibbous" : moonAge < 0.5625 ? "Full Moon" : moonAge < 0.6875 ? "Waning Gibbous" : moonAge < 0.8125 ? "Last Quarter" : "Waning Crescent"

  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  component Stat(glyph, label, value, tint = foreground) {
    Row {
      gap: 10
      align: center
      padding: [10, 8]
      border: 1
      borderColor: alpha(muted, 0.3)
      Text { text: glyph; font: icon; fontSize: 22; color: tint; width: 34; align: center }
      Column {
        gap: 0
        weight: 1
        Text { text: label; style: label; color: muted; maxLines: 1 }
        Text { text: value; style: body; maxLines: 1 }
      }
    }
  }

  Column {
    gap: 0
    // A short tile (a 3x3 on the landscape home screen) gets the date on one line, so the forecast row still fits,
    // and so does a narrow one, where the month won't fit beside the big day.
    if short || narrow {
      Row {
        gap: 6
        align: center
        Text { text: fmtTime(now, "d"); fontSize: 20; width: 28; maxLines: 1 }
        Text { text: lower(fmtTime(now, "EEEE")); style: label; color: accent; weight: 1; maxLines: 1 }
        if !narrow {
          Text { text: lower(fmtTime(now, "MMMM")); style: small; color: muted; width: 76; align: end; maxLines: 1 }
        }
      }
    } else {
      Row {
        gap: 10
        align: center
        Text { text: fmtTime(now, "d"); style: huge; width: 60 }
        Column {
          gap: 0
          weight: 1
          Text { text: lower(fmtTime(now, "EEEE")); style: label; color: accent; maxLines: 1 }
          Text { text: lower(fmtTime(now, "MMMM yyyy")); style: small; color: muted; maxLines: 1 }
        }
      }
    }
    Spacer { weight: 1 }
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
    Spacer { height: 8 }
    if cur != null {
      Row {
        gap: 6
        align: bottom
        Text { text: get(night ? nightIcons : dayIcons, "${int(code)}", ""); font: icon; fontSize: 32; color: sky; width: 26; padding: [0, 0, 0, 3] }
        Text { text: "${round(num(cur.temperature_2m))}°"; fontSize: 28; color: cyan; width: 68; maxLines: 1 }
        if !narrow {
          Column {
            gap: 0
            weight: 1
            Text { text: str.sky("${int(code)}"); style: small; align: end; maxLines: 1 }
            Text { text: "↑${round(num(daily.temperature_2m_max[0]))}° ↓${round(num(daily.temperature_2m_min[0]))}°"; style: small; color: muted; align: end; maxLines: 1; padding: [0, 0, 0, 5] }
          }
        }
      }
      Text { text: "${str.feels} ${round(num(cur.apparent_temperature))}° · ${lower(place)}"; style: small; color: muted; maxLines: 1 }
      if !low {
        Spacer { weight: 1 }
        Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
        Spacer { height: 8 }
        // The next two days (icon from the day's own summary), then sunrise and sunset.
        // Each named from its own date: just after midnight, the forecast from before it still starts yesterday.
        Row {
          gap: 4
          align: center
          for i in take(drop(range(4), 1), 2) {
            Column {
              gap: 0
              weight: 1
              align: center
              Text { text: lower(fmtTime(parseTime(daily.time[i]), "EEE")); style: label; color: muted; align: center }
              Text { text: get(dayIcons, "${int(daily.weather_code[i])}", ""); font: icon; fontSize: 18; align: center }
              Text { text: "${round(num(daily.temperature_2m_max[i]))}° ${round(num(daily.temperature_2m_min[i]))}°"; style: small; align: center; maxLines: 1 }
            }
          }
          if !narrow {
            Column {
              gap: 4
              weight: 1.2
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: yellow; width: 28 }
                Text { text: sun[0]; style: small; maxLines: 1; weight: 1 }
              }
              Row {
                gap: 4
                align: center
                Text { text: ""; font: icon; fontSize: 14; color: orange; width: 28 }
                Text { text: sun[1]; style: small; maxLines: 1; weight: 1 }
              }
            }
          }
        }
      }
    } else {
      Text { text: (lat == null && geo != null) || wxFailed ? str.offline : str.loading; style: small; color: muted }
    }
  }

  screen {
    title: str.title
    Input {
      text: city
      placeholder: str.city
      onSubmit: { city = trim(value); refresh() }
    }
    if cur == null {
      Text { text: (lat == null && geo != null) || wxFailed ? str.offline : str.loading; style: body; color: muted }
    } else {
      Column {
        scroll: true
        gap: 14
        // Now.
        Row {
          gap: 16
          align: center
          Text { text: get(night ? nightIcons : dayIcons, "${int(code)}", ""); font: icon; fontSize: 64; color: sky; width: 80; align: center }
          Column {
            gap: 0
            weight: 1
            Text {
              text: "${round(num(cur.temperature_2m))}°${unit}"
              fontSize: 44
              color: cyan
              maxLines: 1
              onTap: unitChoice = unit == "C" ? "F" : "C"
            }
            Text { text: str.sky("${int(code)}"); style: body; maxLines: 2 }
          }
        }
        Text {
          text: "${str.feels} ${round(num(cur.apparent_temperature))}° · ↑${round(num(daily.temperature_2m_max[0]))}° ↓${round(num(daily.temperature_2m_min[0]))}° · ${lower(place)}, ${lower(country)}"
          style: small
          color: muted
        }
        Rule { }
        Grid {
          columns: 2
          gap: 8
          Stat { glyph: ""; label: str.wind(windDir); value: "${round(num(cur.wind_speed_10m))} ${imperial ? "mph" : str.kmh}"; tint: cyan }
          Stat { glyph: ""; label: str.humidity; value: "${round(num(cur.relative_humidity_2m))}%"; tint: blue }
          Stat { glyph: ""; label: str.rainToday; value: "${round(num(daily.precipitation_probability_max[0]))}% · ${fixed(num(daily.precipitation_sum[0]), 1)} ${imperial ? "in" : "mm"}"; tint: blue }
          Stat { glyph: ""; label: str.uv; value: "${round(uv)} ${str.uvLevel(uv)}"; tint: uv >= 6 ? red : uv >= 3 ? yellow : green }
          Stat { glyph: ""; label: str.pressure; value: imperial ? "${fixed(num(cur.pressure_msl) * 0.02953, 2)} inHg" : "${round(num(cur.pressure_msl))} hPa" }
          Stat { glyph: ""; label: str.visibility; value: imperial ? "${fixed(num(hourly.visibility[hi]) / 1609.344, 1)} mi" : "${fixed(num(hourly.visibility[hi]) / 1000, 1)} km" }
        }
        Rule { }
        // The next 24 hours: time, icon and rain chance per step, with the temperature curve under them.
        Text { text: str.next24; style: label; color: accent }
        Column {
          gap: 4
          Row {
            gap: 0
            for s, i in steps key s.hr {
              Column {
                gap: 2
                weight: 1
                align: center
                Text { text: i == 0 ? str.now : pad(s.hr, 2, "0"); style: label; color: muted; align: center }
                Text { text: get(s.night ? nightIcons : dayIcons, "${int(s.code)}", ""); font: icon; fontSize: 20; align: center }
              }
            }
          }
          Canvas {
            height: 84
            fill: width
            let n = max(len(steps), 1)
            let temps = steps.map(s => s.t)
            let lo = min(temps)
            let hi = max(temps)
            let ys = temps.map(t => 22 + (hi - t) / max(hi - lo, 1) * 26)
            let xs = range(n).map(i => (i + 0.5) * width / n)
            path(range(n).map(i => [xs[i], ys[i]]), stroke: accent, width: 2)
            for s, i in steps {
              circle(xs[i], ys[i], 3, fill: accent)
              text("${round(s.t)}°", xs[i], ys[i] - 13, size: 12, align: center, color: foreground)
              rect(xs[i] - 10, height - 12, 20, 4, radius: 2, fill: alpha(muted, 0.2))
              rect(xs[i] - 10, height - 12, 20 * s.rain / 100, 4, radius: 2, fill: blue)
              text("${s.rain}%", xs[i], height - 24, size: 10, align: center, color: s.rain >= 30 ? blue : muted)
            }
          }
        }
        Rule { }
        // Three days: icon, rain chance and the day's low to high on a shared scale.
        Text { text: str.days; style: label; color: accent }
        for i in range(3) {
          let lo = round(num(daily.temperature_2m_min[i]))
          let hi = round(num(daily.temperature_2m_max[i]))
          Row {
            gap: 8
            align: center
            Text { text: i == 0 ? str.today : lower(fmtTime(parseTime(daily.time[i]), "EEE")); style: body; width: 64; maxLines: 1 }
            Text { text: get(dayIcons, "${int(daily.weather_code[i])}", ""); font: icon; fontSize: 20; width: 26; align: center }
            Text { text: "${round(num(daily.precipitation_probability_max[i]))}%"; style: small; color: blue; width: 40; align: end; maxLines: 1 }
            Text { text: "${lo}°"; style: small; color: muted; width: 36; align: end; maxLines: 1 }
            Canvas {
              height: 6
              weight: 1
              let span = max(highest - lowest, 1)
              let x0 = (lo - lowest) / span * width
              let x1 = (hi - lowest) / span * width
              rect(0, 0, width, height, radius: 3, fill: alpha(muted, 0.2))
              rect(x0, 0, max(x1 - x0, 6), height, radius: 3, fill: linear(0, 0, width, 0, [cyan, orange]))
            }
            Text { text: "${hi}°"; style: small; width: 36; maxLines: 1 }
          }
        }
        Rule { }
        // Sun and moon.
        Row {
          gap: 8
          Stat { glyph: ""; label: str.sunrise; value: sun[0]; tint: yellow; weight: 1 }
          Stat { glyph: ""; label: str.sunset; value: sun[1]; tint: orange; weight: 1 }
        }
        Stat {
          glyph: get(moonIcons, moonPhase, "")
          label: str.moon
          value: str.phase(moonPhase, moonLit)
          tint: foreground
        }
        // yr.no (Norwegian Meteorological Institute): ad-free and worldwide, opened at the forecast's coordinates.
        Row {
          justify: end
          Button { text: str.yr; color: muted; onTap: url("https://www.yr.no/en/forecast/daily-table/${fixed(lat, 4)},${fixed(lon, 4)}") }
        }
      }
    }
  }
}
