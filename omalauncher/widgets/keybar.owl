keybar "terminal key bar" {
  // The keys a phone keyboard lacks, over it while you type in a terminal: on home and in a Linux app's window. They're
  // yours to change: ask your agent to edit them. .stock-keybar.owl next to it is this file as the launcher ships it, kept
  // up to date: compare the two to see what changed in a newer launcher. If this file is gone or doesn't compile, the
  // stock keys show instead.
  meta { description: "The key bar over the keyboard while typing in a terminal: esc, tab, ctrl, alt, the arrows, copy, paste and photos"; version: "1.3"; license: "MIT"; category: "system"; owl: 16 }
  // The launcher's chevron; currentColor takes the tint.
  asset chevron = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iY3VycmVudENvbG9yIiBkPSJNNy40MSwxNS40MUwxMiwxMC44M2w0LjU5LDQuNThMMTgsMTRsLTYsLTYgLTYsNnoiLz48L3N2Zz4="
  // Material Design Icons' backspace-outline, for the prompt line's key that deletes in it.
  asset backspace = base64""
  // Material Design Icons' copy, paste and image, for the clipboard keys and the one that pastes photos.
  asset copyIcon = base64"PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iY3VycmVudENvbG9yIiBkPSJNMTksMjFIOFY3SDE5TTE5LDVIOEEyLDIgMCAwLDAgNiw3VjIxQTIsMiAwIDAsMCA4LDIzSDE5QTIsMiAwIDAsMCAyMSwyMVY3QTIsMiAwIDAsMCAxOSw1TTE2LDFINEEyLDIgMCAwLDAgMiwzVjE3SDRWM0gxNlYxWiIvPjwvc3ZnPg=="
  asset pasteIcon = base64""
  asset photo = base64""
  // Whether ctrl, alt and shift are latched: "off", "once" (for the next key) or "locked".
  // The names TalkBack reads for the icon keys, in the phone's language where it has a set.
  strings {
    en { copy: "copy"; paste: "paste"; photos: "photos" }
    id { copy: "salin"; paste: "tempel"; photos: "foto" }
    es { copy: "copiar"; paste: "pegar"; photos: "fotos" }
    pt { copy: "copiar"; paste: "colar"; photos: "fotos" }
    de { copy: "kopieren"; paste: "einfügen"; photos: "fotos" }
    zh { copy: "复制"; paste: "粘贴"; photos: "照片" }
  }
  source kb = android.modifiers
  // The key under the finger, drawn pressed.
  state down = ""
  // The prompt line, Termux's input area: a real text field over the keys, where the keyboard's suggestions, glide
  // typing and microphone work (a terminal's own field has none of them). Swipe the strip above the keys up to open
  // it, down to close it, or tap it; what it holds goes into the window that has the keyboard, a newline after it.
  state prompt = false
  state draft = ""
  state dragged = 0
  state deleting = false

  // Each key: what it shows, then what it sends, pressKey(...)'s names, or the modifier it latches. repeats: held, it
  // sends again and again, like a keyboard's arrows; arrow: a chevron turned that many degrees instead of the label;
  // icon: an asset shown instead of the label. Ctrl+Insert and Shift+Insert are the clipboard keys foot, GTK and Qt all
  // know. images: Android's photo picker, whose picks paste as their paths in Linux, which opencode and Claude Code attach.
  let rows = [
    [
      {label: "esc", key: "esc"},
      {label: "/", key: "/"},
      {label: "-", key: "-"},
      {label: "home", key: "home"},
      {label: "up", key: "up", repeats: true, arrow: 0},
      {label: "end", key: "end"},
      {label: "pgup", key: "pgup", repeats: true},
      {label: str.copy, key: "ctrl+insert", icon: copyIcon},
      {label: "|", key: "|"}
    ],
    [
      {label: "tab", key: "tab"},
      {label: "ctrl", latch: "ctrl"},
      {label: "alt", latch: "alt"},
      {label: "left", key: "left", repeats: true, arrow: -90},
      {label: "down", key: "down", repeats: true, arrow: 180},
      {label: "right", key: "right", repeats: true, arrow: 90},
      {label: "pgdn", key: "pgdn", repeats: true},
      {label: str.paste, key: "shift+insert", icon: pasteIcon},
      {label: str.photos, images: true, icon: photo}
    ]
  ]

  // A key that sends as the finger goes down; held with repeats, again every 50 ms after 400 ms.
  component Plain(k) {
    Box {
      fill: true
      align: center
      radius: 8 * corners
      background: down == k.label ? accent : surface
      repeats: k.repeats ?? false
      onPress: {
        if repeat == 0 {
          down = k.label
          haptic()
        }
        pressKey(k.key)
      }
      onRelease: down = ""
      if k.arrow != null {
        Image { src: chevron; size: 20; rotation: k.arrow; tint: down == k.label ? background : foreground; label: k.label }
      } else if k.icon != null {
        Image { src: k.icon; size: 20; tint: down == k.label ? background : foreground; label: k.label }
      } else {
        Text { text: k.label; font: mono; fontSize: 14; maxLines: 1; align: center; color: down == k.label ? background : foreground }
      }
    }
  }

  // The photo picker opens on a tap, not as the finger goes down: it covers the bar before the finger lifts.
  component Images(k) {
    Box {
      fill: true
      align: center
      radius: 8 * corners
      background: down == k.label ? accent : surface
      onPress: {
        down = k.label
        haptic()
      }
      onRelease: down = ""
      onTap: pickImages()
      Image { src: k.icon; size: 20; tint: down == k.label ? background : foreground; label: k.label }
    }
  }

  // ctrl and alt: a tap holds them for the next key, outlined, and a long press until tapped again, filled.
  component Latched(k) {
    let held = get(kb ?? {}, k.latch, "off")
    Box {
      fill: true
      align: center
      radius: 8 * corners
      background: held == "locked" ? accent : surface
      border: held == "once" ? 2 : 0
      borderColor: accent
      onPress: haptic()
      onTap: latch(k.latch)
      onLongPress: latch(k.latch, "locked")
      Text { text: k.label; font: mono; fontSize: 14; align: center; color: held == "locked" ? background : held == "once" ? accent : foreground }
    }
  }

  // The prompt line: the field and its send key, as tall as a key row.
  component PromptLine() {
    Row {
      height: 40
      gap: 0
      Box {
        weight: 1
        fill: height
        padding: 3
        align: center
        Input {
          text: draft
          placeholder: "swipe a prompt"
          underline: false
          onChange: draft = value
          onSubmit: {
            if draft != "" {
              typeText(draft + "\n")
              draft = ""
            }
          }
        }
      }
      // Backspace in the line, not in the window: the keys' own backspace would delete in the terminal instead.
      Box {
        width: 58
        fill: height
        padding: 3
        Box {
          fill: true
          align: center
          radius: 8 * corners
          background: deleting ? accent : surface
          repeats: true
          onPress: {
            if repeat == 0 {
              haptic()
            }
            deleting = true
            if len(draft) > 0 {
              draft = sub(draft, 0, len(draft) - 1)
            }
          }
          onRelease: deleting = false
          Image { src: backspace; size: 20; tint: deleting ? background : foreground; label: "backspace" }
        }
      }
      Box {
        width: 72
        fill: height
        padding: [9, 3, 3, 3]
        Box {
          fill: true
          align: center
          radius: 8 * corners
          padding: [6, 0, 6, 0]
          background: draft == "" ? surface : accent
          ripple: false
          onTap: {
            if draft != "" {
              typeText(draft + "\n")
              draft = ""
              haptic()
            }
          }
          Text { text: "send"; font: mono; fontSize: 13; letterSpacing: 1; color: draft == "" ? muted : background }
        }
      }
    }
  }

  // Framed like the tiles above it, by the terminal key bar's gaps and border width in settings › style: gapsOut to the
  // screen's sides and the keyboard. 6 between the keys and to the frame, half of it around each key.
  Column {
    padding: [gapsOut, 0, gapsOut, gapsOut]
    gap: 0
    // The strip that opens the line: swiped up or down, or tapped.
    Row {
      fill: width
      height: 18
      justify: center
      align: center
      drag: vertical
      onDrag: dragged = dragged + dy
      onDragEnd: {
        if dragged < -10 {
          prompt = true
        } else if dragged > 10 {
          prompt = false
        }
        dragged = 0
      }
      onTap: prompt = !prompt
      Text {
        text: prompt ? "prompt line ▾" : "prompt line ▴"
        font: mono
        fontSize: 10
        color: muted
      }
    }
    Column {
      gap: 0
      padding: 3
      background: background
      border: borderWidth
      borderColor: border
      radius: 12 * corners
      if prompt {
        PromptLine { }
      }
      for row in rows {
        Row {
          height: 40
          gap: 0
          for k in row {
            Box {
              weight: 1
              fill: height
              padding: 3
              if k.latch != null {
                Latched { k: k }
              } else if k.images ?? false {
                Images { k: k }
              } else {
                Plain { k: k }
              }
            }
          }
        }
      }
    }
  }
}
