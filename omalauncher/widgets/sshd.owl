widget "sshd" {
  size: 8x1
  minSize: 2x1
  meta { owl: 12; description: "SSH into this phone: whether the server runs, the address to reach it on the NetBird tunnel or Wi-Fi, and a tap to start it"; version: "1.1"; license: "MIT"; category: "system" }

  requires { pacman: ["openssh", "iproute2"] }

  // sshd itself, the addresses this phone answers on, and whether a key is allowed in yet.
  source pid = cmd("pgrep -x sshd || true") every 30s
  source addrs = cmd("ip -br -4 addr show") every 30s
  // Non-empty lines of authorized_keys: without one, only a password could get in, and passwords are off.
  source keys = cmd("awk 'NF{n++} END{print n+0}' ~/.ssh/authorized_keys 2>/dev/null || echo 0") every 5m
  // A clock that changes every half minute, so a server that went away is started again.
  source tick = clock every 30s

  // Android won't let the launcher's Linux bind below 1024, so omarchy-sshd listens here.
  let port = 2222
  let up = pid != null && join(words(pid), "") != ""
  let keyed = (keys ?? "0") != "0"
  let ips = addrs == null ? [] : lines(addrs).map(l => words(l)).filter(w => len(w) > 2).map(w => split(w[2], "/")[0])
  // NetBird's tunnel is the 100.64.0.0/10 address (tun1, wt0); the phone's Wi-Fi is the other one.
  let nb = ips.find(a => split(a, ".")[0] == "100")
  let lan = ips.find(a => startsWith(a, "192.168.") || startsWith(a, "10.") || startsWith(a, "172."))
  let where = nb ?? lan ?? ""

  // Starts it at boot, and again if it ever goes: the widget's shell outlives the tile, and the server with it.
  on tick first { if !up { run("/usr/local/bin/omarchy-sshd") } }
  on tick { if !up { run("/usr/local/bin/omarchy-sshd") } }

  // Down: start it. Up without a key: open the file to paste one into, since nothing can log in yet.
  onTap: {
    if !up { run("/usr/local/bin/omarchy-sshd") }
    if up && !keyed { run("omarchy-edit ~/.ssh/authorized_keys") }
  }

  let dim = mix(muted, foreground, 0.5)
  let color = !up ? muted : (keyed ? green : yellow)

  Row {
    align: center
    gap: 8
    fill: true
    Spacer { size: 8; radius: 4; background: up ? color : alpha(muted, 0.5) }
    Text { text: "sshd"; style: body; bold: true; maxLines: 1 }
    Text { text: up ? (keyed ? "on" : "no key") : "off"; style: small; bold: true; color: color; maxLines: 1 }
    Spacer { weight: 1 }
    Text {
      text: !up ? "tap to start" : (keyed ? (where == "" ? ":${port}" : "${where}:${port}") : "tap to add your key")
      style: small
      font: mono
      color: !up || keyed ? dim : yellow
      maxLines: 1
    }
  }
}
