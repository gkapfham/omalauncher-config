face "omarchy" {
  // A session in the Omarchy way: a bar, gaps, and tiled windows on the wallpaper.
  // Its windows have home's tile glass: widgets.opacity and frosted glass from settings › style.
  // Workspace 1 is the desktop. 2 apps, 3 agents.

  meta {
    owl: 18
    description: "An Omarchy session: a bar, tiled windows, fastfetch, agents, and your apps"
    version: "1.1"
    license: "MIT"
    category: "system"
  }

  requires { pacman: ["pacman"] }

  statusBar: false
  padding: 0

  source now = clock every 1m
  source dev = android.device
  source sys = android.system every 1m
  source bat = android.battery
  source modes = android.modes
  source m = android.media
  source al = android.alarm
  source apps = android.apps
  source rec = android.recent
  source ag = android.agents
  // Arch, once Linux is installed. Base tools only, so the face still runs without it. Hourly: each run starts
  // a process in Linux, and the release, the package count and the shell hardly change.
  source lx = cmd("""
    . /etc/os-release
    printf '%s\t%s\t%s\n' "$PRETTY_NAME" "$(pacman -Qq | wc -l)" "$(basename "$SHELL")"
  """) every 1h optional

  state ws = 1
  state focused = "fetch"
  // The clock's menu: what the bar's clock opens on a tap or a long press.
  state clockMenu = false

  let host = lower(replace(trim(dev.model ?? "phone"), " ", "-"))
  let user = linux ? "root" : "user"
  let mem = sys.memory
  let wide = (tileWidth ?? 0) > (tileHeight ?? 1)
  let playing = m != null && m.title != null && m.title != ""
  let osName = !linux ? (dev == null ? null : "Android ${dev.android}") : (lx == null || lx == "" ? null : trim(split(lx, "\t")[0]))
  let pkgLine = !linux ? (sys.apps == null ? null : "${sys.apps} (apps)") : (lx == null || lx == "" ? null : "${trim(split(lx, "\t")[1])} (pacman) · ${sys.apps} apps")
  let shellName = !linux || lx == null || lx == "" ? null : trim(split(lx, "\t")[2])
  let cpuLine = sys.cpu == null ? null : trim("${sys.cpu.soc == "" || sys.cpu.soc == null ? sys.cpu.hardware : sys.cpu.soc} (${sys.cpu.cores})")
  let memLine = mem == null || !mem.total ? null : "${fmtBytes(mem.used)} / ${fmtBytes(mem.total)}"
  let batLine = bat == null ? null : "${bat.level}%${bat.charging ? " · charging" : ""}"
  let themeName = lower(sys.theme ?? "default")
  let top = values(groupBy((apps ?? []).filter(a => !a.system || a.score > 0).sortBy(a => -a.score), a => a.name)).map(g => g[0])
  let sideApps = len(rec ?? []) > 0 ? (rec ?? []).take(24) : top.take(24)
  let ink = alpha(muted, 0.55)
  let glass = alpha(background, tileOpacity)
  let gap = 5
  // The phone's clock app, for the menu: the one that set the next alarm, else the first one named so.
  let clockApp = (apps ?? []).find(a => contains(lower(a.name), "clock"))

  component Ws(n) {
    Column {
      gap: 2
      align: center
      width: 22
      padding: [0, 1]
      onTap: { ws = n; haptic() }
      Text { text: "${n}"; font: mono; fontSize: 14; fontWeight: ws == n ? 700 : 500; color: ws == n ? accent : alpha(foreground, 0.55); align: center; width: 22 }
      Box { width: 14; height: 2; background: ws == n ? accent : alpha(foreground, 0) }
    }
  }

  component Line(key, value) {
    Row {
      gap: 12
      Text { text: key; font: mono; fontSize: 14; color: accent; width: 88; maxLines: 1 }
      Text { text: value; font: mono; fontSize: 14; maxLines: 1; weight: 1 }
    }
  }

  component Palette() {
    Column {
      gap: 3
      for row in [[color0, color1, color2, color3, color4, color5, color6, color7], [color8, color9, color10, color11, color12, color13, color14, color15]] {
        Row {
          gap: 3
          for c in row { Box { width: 16; height: 8; background: c } }
        }
      }
    }
  }

  component Fetch() {
    Column {
      fill: width
      gap: 10
      padding: [14, 12]
      background: glass
      frost: tileFrost
      border: 2
      borderColor: focused == "fetch" ? accent : ink
      clip: true
      onTap: focused = "fetch"
      Text {
        spans: [{text: user, color: accent, bold: true}, "@", {text: host, color: accent, bold: true}]
        font: mono
        fontSize: 16
        maxLines: 1
      }
      Palette {}
      Column {
        gap: 3
        Line { key: "os"; value: osName }
        Line { key: "host"; value: dev == null ? null : "${dev.maker} ${dev.model}" }
        Line { key: "kernel"; value: sys.kernel }
        Line { key: "uptime"; value: sys.uptime == null ? null : fmtDuration(sys.uptime) }
        Line { key: "pkgs"; value: pkgLine }
        if linux { Line { key: "shell"; value: shellName } }
        Line { key: "wm"; value: sys.launcher == null ? null : "omalauncher ${sys.launcher}" }
        Row {
          gap: 12
          onTap: launcher("themes")
          Text { text: "theme"; font: mono; fontSize: 14; color: accent; width: 88; maxLines: 1 }
          Text { text: themeName; font: mono; fontSize: 14; maxLines: 1; weight: 1 }
        }
        Line { key: "cpu"; value: cpuLine }
        Line { key: "memory"; value: memLine }
        Line { key: "battery"; value: batLine }
      }
    }
  }

  component AppGrid(list, columns, iconSize, names = true) {
    Grid {
      columns: columns
      gap: 14
      for a in list key a.key {
        Column {
          gap: 5
          align: center
          onTap: open(a.key)
          Image { src: a.icon; size: iconSize }
          if names {
            Text { text: lower(a.name); font: mono; fontSize: 11; align: center; maxLines: 1 }
          }
        }
      }
    }
  }

  component Apps(full = false, cols = null) {
    Column {
      fill: true
      gap: 10
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: (full || focused == "apps") ? accent : ink
      clip: true
      onTap: focused = "apps"
      Row {
        align: center
        Text { text: full ? "apps" : "recent"; font: mono; fontSize: 12; color: muted; weight: 1 }
        Text { text: "all"; font: mono; fontSize: 12; color: accent; onTap: launcher("drawer") }
      }
      Column {
        scroll: true
        weight: 1
        // The recent list is icons only; the full apps view keeps their names.
        AppGrid { list: full ? top.take(16) : sideApps.take(cols == null ? 10 : cols * 6); columns: cols ?? (full ? (wide ? 6 : 4) : 2); iconSize: full ? 52 : 44; names: full }
      }
    }
  }

  component Agents() {
    Column {
      fill: true
      gap: 8
      padding: 12
      background: glass
      frost: tileFrost
      border: 2
      borderColor: accent
      clip: true
      Row {
        align: center
        Text { text: "agents"; font: mono; fontSize: 12; color: muted; weight: 1 }
        Text { text: "manage"; font: mono; fontSize: 12; color: accent; onTap: launcher("agents") }
      }
      if len(ag.installed ?? []) == 0 {
        Text { text: "no agent installed"; font: mono; fontSize: 14; color: muted; onTap: launcher("agents") }
      } else {
        Column {
          scroll: true
          weight: 1
          gap: 4
          for a in ag.installed key a.key {
            Row {
              gap: 10
              align: center
              padding: [0, 6]
              onTap: open(a.key)
              if a.icon != null { Image { src: a.icon; size: 28 } }
              Column {
                gap: 0
                weight: 1
                Text { text: a.name; font: mono; fontSize: 14; color: ag.default != null && a.key == ag.default.key ? accent : foreground; maxLines: 1 }
                if a.description != null && a.description != "" {
                  Text { text: a.description; font: mono; fontSize: 11; color: muted; maxLines: 2 }
                }
              }
            }
          }
        }
      }
    }
  }

  component Desk() {
    Column {
      fill: true
      gap: gap
      Fetch {}
      Apps { weight: 1; fill: true; cols: 4 }
    }
  }

  Column {
    fill: true
    gap: 0

    // The bar. Logo opens the style screen, the way the Omarchy mark opens its menu.
    Row {
      align: center
      padding: [10, 6]
      background: background
      Row {
        width: 132
        gap: 0
        align: center
        Text { text: "●"; fontSize: 10; color: accent; width: 14; align: center; onTap: launcher("style") }
        Ws { n: 1 }
        Ws { n: 2 }
        Ws { n: 3 }
      }
      Spacer { weight: 1 }
      // The clock: a tap or a long press opens its menu, as the bar's clock does in Omarchy. A long press is the
      // face's own, so a node has to take it: without this one, it would open home's menu instead.
      Box {
        align: center
        padding: [10, 2]
        Text {
          text: fmtTime(now, "EEE d  HH:mm")
          font: mono
          fontSize: 13
          maxLines: 1
          onTap: { haptic(); clockMenu = !clockMenu }
          onLongPress: { haptic(); clockMenu = !clockMenu }
        }
        Popup {
          visible: clockMenu
          onDismiss: clockMenu = false
          width: 260
          gap: 10
          padding: [14, 12]
          background: glass
          frost: tileFrost
          border: 2
          borderColor: accent
          Text { text: fmtTime(now, "HH:mm"); font: mono; fontSize: 32; color: accent; maxLines: 1 }
          Text { text: fmtTime(now, "EEEE d MMMM"); font: mono; fontSize: 12; color: muted; maxLines: 1 }
          Box { height: 1; fill: width; background: ink }
          Row {
            gap: 12
            align: center
            Text { text: "alarm"; font: mono; fontSize: 12; color: accent; width: 64; maxLines: 1 }
            Text { text: al.set ? fmtTime(al.time, "EEE HH:mm") : "none"; font: mono; fontSize: 12; weight: 1; maxLines: 1 }
            if al.set { Text { text: "in " + fmtDuration(al.time - now); font: mono; fontSize: 11; color: muted; maxLines: 1 } }
          }
          Row {
            gap: 12
            align: center
            onTap: {
              clockMenu = false
              if al.set && al.app != null {
                androidApp(al.app)
              } else if clockApp != null {
                androidApp(clockApp.key)
              }
            }
            Text { text: "clock"; font: mono; fontSize: 12; color: accent; width: 64; maxLines: 1 }
            Text {
              text: clockApp == null && !(al.set && al.app != null) ? "no clock app" : "open"
              font: mono
              fontSize: 12
              color: clockApp == null && !(al.set && al.app != null) ? muted : foreground
              weight: 1
              maxLines: 1
            }
            Text { text: "›"; font: mono; fontSize: 12; color: muted }
          }
          Row {
            gap: 12
            align: center
            onTap: { clockMenu = false; calendar("open") }
            Text { text: "calendar"; font: mono; fontSize: 12; color: accent; width: 64; maxLines: 1 }
            Text { text: "today"; font: mono; fontSize: 12; weight: 1; maxLines: 1 }
            Text { text: "›"; font: mono; fontSize: 12; color: muted }
          }
        }
      }
      Spacer { weight: 1 }
      Row {
        width: 132
        gap: 8
        align: center
        justify: end
        if modes.dnd { Text { text: "dnd"; font: mono; fontSize: 12; color: yellow } }
        Text {
          text: bat == null ? null : "${bat.level}%"
          font: mono
          fontSize: 13
          color: bat.charging ? green : bat.level <= 15 ? red : bat.level <= 30 ? yellow : foreground
        }
      }
    }

    if playing {
      Row {
        gap: 8
        align: center
        padding: [12, 5]
        background: background
        onTap: media("toggle")
        Text { text: m.playing == true ? "▶" : "⏸"; font: mono; fontSize: 11; color: accent }
        Text { text: "${m.artist ?? lower(m.app ?? "")} — ${m.title}"; font: mono; fontSize: 12; color: muted; maxLines: 1; weight: 1 }
      }
    }

    Column {
      weight: 1
      fill: width
      gap: gap
      padding: 10
      if ws == 1 {
        Desk { fill: true }
      } else if ws == 2 {
        Apps { full: true; fill: true }
      } else {
        Agents { fill: true }
      }
    }

    Spacer { height: screenInset }
  }
}
