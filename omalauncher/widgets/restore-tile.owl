widget "restore" {
  // A home tile for putting a saved setup back: tap restore for the newest, or the tile for all of them.
  page: 4
  order: 2
  size: 3x3
  minSize: 3x2

  meta {
    owl: 17
    description: "Restore a saved omalauncher setup from Google Drive, with a snapshot, a compile check, automatic rollback and undo"
    version: "1.0"
    license: "MIT"
    category: "system"
  }

  requires { pacman: ["python", "nodejs", "git", "util-linux"] }

  source st = file("~/.cache/owl-config/status.json") json
  source bl = file("~/.cache/owl-config/backups.json") json
  source now = clock every 1m

  state confirm = ""
  state checked = ""

  let busy = st != null && (st.state == "saving" || st.state == "restoring")
  let stateColor = st == null ? muted : st.state == "error" ? red : st.state == "ok" ? green : yellow
  let last = len(bl ?? []) > 0 ? bl[0] : null
  let canUndo = st != null && st.undo == true

  on bl first {
    if len(bl ?? []) == 0 {
      run("setsid -f $HOME/.local/bin/owl-config list >/dev/null 2>&1 </dev/null")
    }
  }

  onTap: screen()

  Column {
    fill: true
    gap: 4
    Row {
      Text { text: "restore"; style: muted; weight: 1 }
      Text { text: st == null ? "ready" : st.state; style: small; color: stateColor }
    }
    if last != null {
      Text { text: fmtTime(last.at, "d MMM"); maxLines: 1 }
      Text { text: fmtTime(last.at, "HH:mm") + " · " + fmtBytes(last.size); style: small; color: muted; maxLines: 1 }
    } else {
      Text { text: "no backups yet"; style: small; color: muted }
    }
    Spacer { weight: 1 }
    Button {
      text: busy ? "working…" : "restore"
      color: busy ? muted : red
      onTap: {
        if !busy && last != null {
          confirm = last.id
          screen()
        }
      }
    }
  }

  screen {
    title: "restore"
    Column {
      fill: true
      gap: 10
      padding: [12, 0, 12, 12]

      Row {
        gap: 8
        Button {
          text: "check newest"
          weight: 1
          onTap: checked = run("$HOME/.local/bin/owl-config check latest")
        }
        Button {
          text: "refresh list"
          weight: 1
          onTap: run("setsid -f $HOME/.local/bin/owl-config list >/dev/null 2>&1 </dev/null")
        }
      }

      Column {
        fill: width
        gap: 6
        padding: [12, 10]
        background: surface
        radius: 8 * corners
        Row {
          align: center
          gap: 8
          Text { text: st == null ? "ready" : st.state; color: stateColor; weight: 1 }
          if st != null {
            Text { text: fmtAgo(st.at, now); style: small; color: muted }
          }
        }
        Text { text: st == null ? "nothing restored yet" : st.message; style: small; color: muted; maxLines: 3 }
        if st != null && st.link != null {
          Text { text: "open in Drive"; color: accent; style: small; onTap: url(st.link) }
        }
      }

      if checked != "" {
        Text { text: checked; style: small; color: muted; maxLines: 4 }
      }

      if canUndo {
        Button {
          text: "undo last restore"
          color: yellow
          onTap: confirm = "undo"
        }
      }

      Text { text: "saved setups"; style: label }

      Column {
        scroll: true
        weight: 1
        gap: 2
        if len(bl ?? []) == 0 {
          Text { text: "nothing in Drive yet"; style: small; color: muted; padding: [0, 4] }
        }
        for b in bl ?? [] key b.id {
          Row {
            fill: width
            gap: 10
            align: center
            padding: [8, 4]
            Text { text: fmtTime(b.at, "EEE d MMM  HH:mm"); weight: 1; maxLines: 1 }
            Text { text: fmtBytes(b.size); style: small; color: muted }
            Button { text: "restore"; color: red; onTap: confirm = b.id }
          }
        }
      }

      Text {
        text: "Restoring snapshots the current setup first, checks every widget after applying, and rolls back automatically if one that compiled before no longer does."
        style: small
        color: muted
        maxLines: 4
      }

      Popup {
        visible: confirm != ""
        onDismiss: confirm = ""
        width: (screenWidth ?? 400) - 48
        gap: 10
        padding: [16, 14]
        Text { text: confirm == "undo" ? "undo the last restore?" : "restore this setup?"; style: title }
        Text {
          text: confirm == "undo" ? "Put back the setup from just before the last restore." : "The current setup is snapshotted first. Every widget is checked after applying; if one no longer compiles, the snapshot is put back automatically."
          style: small
          color: muted
        }
        Row {
          gap: 8
          Button { text: "cancel"; weight: 1; onTap: confirm = "" }
          Button {
            text: confirm == "undo" ? "undo" : "restore"
            color: confirm == "undo" ? yellow : red
            weight: 1
            onTap: {
              if confirm == "undo" {
                run("setsid -f $HOME/.local/bin/owl-config undo >/dev/null 2>&1 </dev/null")
              } else {
                run("setsid -f $HOME/.local/bin/owl-config restore ${sh(confirm)} >/dev/null 2>&1 </dev/null")
              }
              confirm = ""
            }
          }
        }
      }
    }
  }
}
