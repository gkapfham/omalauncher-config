widget "agenda" {
  size: 9x6
  minSize: 3x3
  requires { pacman: ["python", "nodejs"] }
  padding: 12

  meta {
    owl: 17
    description: "The next days of your Google calendars. owl-agenda fetches them itself, so it works with pi closed; tap for two weeks, pull down to refresh"
    version: "1.0"
    license: "MIT"
    category: "productivity"
  }

  // owl-agenda (in ~/.local/bin) asks Google with the token the pi google-workspace skill keeps, and prints the
  // events as JSON. No account yet: it prints `error`, which the tile shows with a tap that signs one in.
  // One retry after a pause, because a token refresh or the network can fail once and then work again.
  source ev = cmd("owl-agenda json || { sleep 5; owl-agenda json; }") every 10m json timeout 90s status
  source now = clock every 1m

  // The last good answer, kept so that a fetch that fails leaves the schedule where it is instead of emptying
  // the tile; `offline` then says how old what's shown is.
  state last = null persist
  on ev first { if ev.ok { last = ev.out } }
  on ev { if ev.ok { last = ev.out } }

  let today = fmtTime(now, "yyyy-MM-dd")
  let tomorrow = fmtTime(now + 86400, "yyyy-MM-dd")
  // `raw` is what to draw: this fetch's answer, or the last one that worked. `problem` is why the last fetch
  // failed, `stale` that we're showing older data because of it, and `failed` that there's nothing to show.
  let raw = ev != null && ev.ok ? ev.out : last
  let problem = ev == null || ev.ok ? null : (ev.out.error ?? ev.err ?? "offline")
  let stale = problem != null && last != null
  let failed = problem != null && last == null ? problem : null
  let since = raw != null && raw.at != null ? fmtTime(raw.at, "HH:mm") : null
  let staleNote = since == null ? "can't reach Google — showing what I last had" : "can't reach Google — showing the last update, ${since}"
  let events = raw.events ?? []
  let cals = raw.cals ?? []
  // What fits: 12 of padding top and bottom, the heading row 18, a day heading 22, an event row 23, and
  // 16 for the "+N more" line when there are more events than fit. The tile can be any size.
  let inner = (tileHeight ?? 460) - 24 - 18
  let heights = scan(events, (h, e, i) => h + (i == 0 || events[i - 1].day != e.day ? 22 : 0) + 23, 0)
  let fits = len(heights.filter(h => h <= inner))
  let rows = clamp(fits < len(events) ? len(heights.filter(h => h <= inner - 16)) : fits, 1, 50)
  let shown = events.take(rows)

  // One event: the calendar's colour, its time, its name. Past ones, still listed today, dimmed.
  component Event(e) {
    Row {
      height: 21
      gap: 7
      align: center
      Box { width: 6; height: 6; radius: 3; background: cals[e.ci].c ?? accent }
      Text { text: e.all ? "all day" : e.time; font: mono; fontSize: 10; width: 72; color: muted; maxLines: 1 }
      Text { text: e.t; fontSize: 13; weight: 1; maxLines: 1; color: e.e < now ? muted : foreground }
    }
  }

  // A day's heading: today and tomorrow by name, the rest by date.
  component DayHeading(day, at) {
    Text {
      text: day == today ? "TODAY" : day == tomorrow ? "TOMORROW" : upper(fmtTime(at, "EEE d MMM"))
      font: mono
      fontSize: 10
      color: accent
      maxLines: 1
      letterSpacing: 1
    }
  }

  onTap: screen()

  Column {
    gap: 2
    Row {
      gap: 6
      align: center
      Text { text: "agenda"; font: mono; fontSize: 11; color: muted; weight: 1; maxLines: 1; letterSpacing: 1 }
      if stale {
        Text {
          text: since != null ? "offline ${since}" : "offline"
          font: mono
          fontSize: 10
          color: orange
          maxLines: 1
        }
      } else if raw == null {
        Text { text: "…"; font: mono; fontSize: 10; color: muted; maxLines: 1 }
      }
    }
    if failed != null {
      Text {
        text: contains(failed, "no account") ? "no Google account yet — tap to sign in" : failed
        style: small
        color: muted
        maxLines: 3
        onTap: terminal("owl-agenda login")
      }
    } else if raw == null {
      Text { text: "loading…"; style: small; color: muted }
    } else if len(events) == 0 {
      Text { text: "nothing in the calendar"; style: small; color: muted }
    } else {
      for e, i in shown key e.s + e.t {
        if i == 0 || shown[i - 1].day != e.day {
          DayHeading { day: e.day; at: e.s }
        }
        Event { e: e }
      }
      if len(events) > len(shown) {
        Text { text: "+${len(events) - len(shown)} more"; font: mono; fontSize: 10; color: muted; maxLines: 1 }
      }
    }
  }

  screen {
    title: "agenda"
    if failed != null {
      Column {
        gap: 10
        Text { text: failed; style: body; maxLines: 6 }
        Text { text: "owl-agenda login"; font: mono; style: body; color: accent; onTap: terminal("owl-agenda login") }
      }
    } else {
      Column {
        scroll: true
        gap: 2
        onPull: refresh()
        if stale {
          Text {
            text: staleNote
            style: small
            color: orange
            padding: [0, 6, 0, 12]
          }
        }
        for e, i in events key e.s + e.t {
          if i == 0 || events[i - 1].day != e.day {
            Box {
              padding: [0, 10, 0, 4]
              DayHeading { day: e.day; at: e.s }
            }
          }
          Row {
            gap: 8
            padding: [0, 7, 0, 7]
            align: top
            // The dot and the time line up with the first line of a title that may take two.
            Box { width: 8; height: 8; radius: 4; background: cals[e.ci].c ?? accent; offset: [0, 6] }
            Text { text: e.all ? "all day" : "${e.time}–${e.until}"; font: mono; fontSize: 12; width: 118; color: muted; maxLines: 1; offset: [0, 2] }
            Column {
              weight: 1
              gap: 2
              Text { text: e.t; fontSize: 15; maxLines: 3; color: e.e < now ? muted : foreground }
              if e.loc != "" {
                Text { text: e.loc; style: small; color: muted; maxLines: 2 }
              }
            }
          }
        }
        if len(events) == 0 {
          Text { text: "nothing in the calendar"; style: body; color: muted }
        }
        Box { height: 12 }
      }
    }
  }
}
