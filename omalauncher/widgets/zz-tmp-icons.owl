panel "tmp icons" {
  // The app drawer: swiping up on home opens it, above the prompt bar. It's a panel like any other, so it's yours to
  // change: ask your agent to edit it, or pick another panel in settings › gestures. .stock-drawer.owl next to it is
  // this file as the launcher ships it, kept up to date: compare the two to see what changed in a newer launcher.
  meta { description: "The launcher's app drawer, written in owl: your apps in one column, renamed or grouped in folders, search as you type in the prompt bar, and a long-press menu that hides an app"; version: "1.4"; license: "MIT"; category: "system"; owl: 16 }
  // The launcher's gear, as its settings buttons draw it; currentColor takes the accent.
  asset gear = base64""
  // What the drawer says, in the phone's language where it has a set, and in English where it doesn't. The action
  // words (pin, info, ...) are appAction's, so a long-press menu names each with get(str, word).
  strings {
    en {
      personal: "personal"; work: "work"; apps: "apps"; linux: "linux"; shortcuts: "shortcuts"; android: "android"
      workApps: "work apps"; workPaused: "work apps paused"; linuxApps: "linux apps"
      pin: "add to home"; info: "app info"; uninstall: "uninstall"; remove: "remove"; edit: "edit"; share: "share"
      settings: "settings"; turnOn: "turn on"; pause: "pause"; installing: "installing…"; installLinux: "install linux"
      open: "open"; ask: "ask"; askInstallLinux: "ask an agent · install linux"; askInstallAgent: "ask an agent · install one"
      askAgent: (bin, text) => "ask ${bin}: ${text}"
      hide: "hide"; unhide: "unhide"; hiddenApps: "hidden apps"
      icon: "icon"; ownIcon: "own icon"; initialsIcon: "initials"; typeIcon: "character or emoji…"; iconFile: "svg or png in this system…"; borrowIcon: "or another app's icon"; cancel: "cancel"
      rename: "rename"; addToFolder: "add to folder"; removeFromFolder: "remove from folder"; newFolder: "new folder…"; deleteFolder: "delete folder"
    }
    id {
      personal: "pribadi"; work: "kerja"; apps: "aplikasi"; linux: "linux"; shortcuts: "pintasan"; android: "android"
      workApps: "aplikasi kerja"; workPaused: "aplikasi kerja dijeda"; linuxApps: "aplikasi linux"
      pin: "tambah ke layar utama"; info: "info aplikasi"; uninstall: "uninstal"; remove: "hapus"; edit: "edit"; share: "bagikan"
      settings: "setelan"; turnOn: "aktifkan"; pause: "jeda"; installing: "menginstal…"; installLinux: "instal linux"
      open: "buka"; ask: "tanya"; askInstallLinux: "tanya agen · instal linux"; askInstallAgent: "tanya agen · instal satu"
      askAgent: (bin, text) => "tanya ${bin}: ${text}"
      hide: "sembunyikan"; unhide: "tampilkan lagi"; hiddenApps: "aplikasi tersembunyi"
      icon: "ikon"; ownIcon: "ikon sendiri"; initialsIcon: "inisial"; typeIcon: "karakter atau emoji…"; iconFile: "svg atau png di sistem ini…"; borrowIcon: "atau ikon aplikasi lain"; cancel: "batal"
      rename: "ganti nama"; addToFolder: "tambah ke folder"; removeFromFolder: "hapus dari folder"; newFolder: "folder baru…"; deleteFolder: "hapus folder"
    }
    es {
      personal: "personal"; work: "trabajo"; apps: "apps"; linux: "linux"; shortcuts: "accesos directos"; android: "android"
      workApps: "apps de trabajo"; workPaused: "apps de trabajo en pausa"; linuxApps: "apps de linux"
      pin: "agregar a inicio"; info: "info de la app"; uninstall: "desinstalar"; remove: "quitar"; edit: "editar"; share: "compartir"
      settings: "configuración"; turnOn: "activar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "preguntar"; askInstallLinux: "preguntar a un agente · instalar linux"; askInstallAgent: "preguntar a un agente · instalar uno"
      askAgent: (bin, text) => "preguntar a ${bin}: ${text}"
      hide: "ocultar"; unhide: "mostrar"; hiddenApps: "apps ocultas"
      icon: "icono"; ownIcon: "icono propio"; initialsIcon: "iniciales"; typeIcon: "carácter o emoji…"; iconFile: "svg o png en este sistema…"; borrowIcon: "o el icono de otra app"; cancel: "cancelar"
      rename: "renombrar"; addToFolder: "añadir a carpeta"; removeFromFolder: "quitar de la carpeta"; newFolder: "carpeta nueva…"; deleteFolder: "eliminar carpeta"
    }
    pt {
      personal: "pessoal"; work: "trabalho"; apps: "apps"; linux: "linux"; shortcuts: "atalhos"; android: "android"
      workApps: "apps de trabalho"; workPaused: "apps de trabalho pausados"; linuxApps: "apps linux"
      pin: "adicionar à tela inicial"; info: "informações do app"; uninstall: "desinstalar"; remove: "remover"; edit: "editar"; share: "compartilhar"
      settings: "configurações"; turnOn: "ativar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "perguntar"; askInstallLinux: "perguntar a um agente · instalar linux"; askInstallAgent: "perguntar a um agente · instalar um"
      askAgent: (bin, text) => "perguntar ao ${bin}: ${text}"
      hide: "ocultar"; unhide: "mostrar"; hiddenApps: "apps ocultos"
      icon: "ícone"; ownIcon: "ícone próprio"; initialsIcon: "iniciais"; typeIcon: "caractere ou emoji…"; iconFile: "svg ou png neste sistema…"; borrowIcon: "ou o ícone de outro app"; cancel: "cancelar"
      rename: "renomear"; addToFolder: "adicionar à pasta"; removeFromFolder: "remover da pasta"; newFolder: "nova pasta…"; deleteFolder: "excluir pasta"
    }
    de {
      personal: "persönlich"; work: "arbeit"; apps: "apps"; linux: "linux"; shortcuts: "verknüpfungen"; android: "android"
      workApps: "arbeits-apps"; workPaused: "arbeits-apps pausiert"; linuxApps: "linux-apps"
      pin: "zum startbildschirm hinzufügen"; info: "app-info"; uninstall: "deinstallieren"; remove: "entfernen"; edit: "bearbeiten"; share: "teilen"
      settings: "einstellungen"; turnOn: "aktivieren"; pause: "pausieren"; installing: "wird installiert…"; installLinux: "linux installieren"
      open: "öffnen"; ask: "fragen"; askInstallLinux: "einen agenten fragen · linux installieren"; askInstallAgent: "einen agenten fragen · einen installieren"
      askAgent: (bin, text) => "${bin} fragen: ${text}"
      hide: "ausblenden"; unhide: "einblenden"; hiddenApps: "ausgeblendete apps"
      icon: "symbol"; ownIcon: "eigenes symbol"; initialsIcon: "initialen"; typeIcon: "zeichen oder emoji…"; iconFile: "svg oder png in diesem system…"; borrowIcon: "oder das symbol einer anderen app"; cancel: "abbrechen"
      rename: "umbenennen"; addToFolder: "zu ordner hinzufügen"; removeFromFolder: "aus ordner entfernen"; newFolder: "neuer ordner…"; deleteFolder: "ordner löschen"
    }
    zh {
      personal: "个人"; work: "工作"; apps: "应用"; linux: "linux"; shortcuts: "快捷方式"; android: "android"
      workApps: "工作应用"; workPaused: "工作应用已暂停"; linuxApps: "linux 应用"
      pin: "添加到主屏幕"; info: "应用信息"; uninstall: "卸载"; remove: "移除"; edit: "编辑"; share: "分享"
      settings: "设置"; turnOn: "开启"; pause: "暂停"; installing: "正在安装…"; installLinux: "安装 linux"
      open: "打开"; ask: "提问"; askInstallLinux: "问智能体 · 安装 linux"; askInstallAgent: "问智能体 · 先装一个"
      askAgent: (bin, text) => "问 ${bin}：${text}"
      hide: "隐藏"; unhide: "取消隐藏"; hiddenApps: "已隐藏的应用"
      icon: "图标"; ownIcon: "应用自带图标"; initialsIcon: "首字母"; typeIcon: "字符或表情…"; iconFile: "本机的 svg 或 png…"; borrowIcon: "或其他应用的图标"; cancel: "取消"
      rename: "重命名"; addToFolder: "添加到文件夹"; removeFromFolder: "从文件夹移除"; newFolder: "新建文件夹…"; deleteFolder: "删除文件夹"
    }
  }
  source d = android.drawer
  source ag = android.agents
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  // The apps hidden from the list and search, by key; long-press › hide adds one, the hidden section unhides it.
  state hidden = {} persist
  // The apps renamed in the drawer, by key; long-press › rename sets one, an empty name brings the app's own back.
  state names = {} persist
  // The folders apps are grouped into, each name's list of app keys; long-press › add to folder puts one in,
  // long-press on a folder's title deletes it (its apps come back to the list).
  state folders = {} persist
  // The icon each app shows instead of its own, by key: {kind, value}, with kind "app" (another app's icon, its key
  // in value), "text" (a character or emoji), "file" (an svg or png in this system) or "initials"; no entry, its own.
  state icons = {"a:com.philips.hearlink2/crc641d37fc9d5495f985.MainActivity": {kind: "text", value: "🎧"}, "l:btop": {kind: "app", value: "a:com.google.android.apps.photos/.MainActivity"}, "l:Cliamp": {kind: "initials", value: ""}}
  // The app whose icon picker is open, by key, "" while it's closed.
  state iconPicking = ""
  // The app being renamed or picked a folder for, by key, "" while neither, and the folder whose title menu is open.
  state renaming = ""
  state picking = ""
  state folderMenu = ""
  // The result picked with the arrow or Tab keys, -1 for the ask row; null follows the ranking.
  state pick = null

  // One app a row: a single-column list, the name beside the icon.
  let cols = 1
  let typed = trim(query)
  let searching = typed != ""
  // The app the icon picker is for, and the apps whose icons it offers, filtered by what's typed in the bar.
  let iconPickingName = find(d.apps, x => x.key == iconPicking) ?? {name: ""}
  let borrowApps = (searching ? rank(d.apps, typed) : d.apps).filter(a => a.key != iconPicking)
  let borrowRows = chunk(borrowApps, 5).map((cells, r) => {key: "i:" + r, cells: cells})
  // A renamed app shows its given name and searches by it, its own name kept as an alias.
  let renamedAll = d.apps.map(a => merge(a, {name: get(names, a.key, a.name), alias: get(names, a.key, a.name) == a.name ? a.alias : a.name}))
  // Hidden apps leave the list (and search) until they're unhidden from the section at its end;
  // an app in a folder leaves the list for its folder's section.
  let mineAll = renamedAll.filter(a => (tab == "work") == (a.profile == "work"))
  let foldered = flatten(keys(folders).map(f => get(folders, f, [])))
  let mine = mineAll.filter(a => !get(hidden, a.key, false) && !any(foldered, k => k == a.key))
  let hiddenApps = mineAll.filter(a => get(hidden, a.key, false))
  // Each folder a section of its apps, ahead of the others; one whose apps are all hidden or gone waits.
  let folderSections = keys(folders).map(f => {id: "folder:" + f, title: f, folder: f, apps: get(folders, f, []).map(k => find(mineAll, a => a.key == k)).filter(a => a != null && !get(hidden, a.key, false))}).filter(s => len(s.apps) > 0)
  // Each section's id keys its rows; its title is the one shown.
  let baseSections = tab == "work" ? [
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "work", title: d.work.paused ? str.workPaused : str.workApps, apps: mine.filter(a => a.kind == "android"), work: true},
      {id: "hidden", title: str.hiddenApps, apps: hiddenApps, hiding: true}
    ] : [
      {id: "apps", title: str.apps, apps: mine.filter(a => a.kind == "owl")},
      {id: "linux", title: str.linux, apps: mine.filter(a => a.kind == "linux"), linux: true},
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "android", title: str.android, apps: mine.filter(a => a.kind == "android")},
      {id: "hidden", title: str.hiddenApps, apps: hiddenApps, hiding: true}
    ]
  let sections = flatten([folderSections, baseSections])
  // A title, then rows of cols apps. Without Linux, its section is an offer to install it.
  let rows = flatten(sections.filter(s => len(s.apps) > 0 || s.work || (s.linux && !linux)).map(s => flatten([
      [{key: "h:" + s.id, title: s.linux && !linux ? str.linuxApps : s.title, work: s.work, offer: s.linux && !linux, folder: s.folder ?? ""}],
      chunk(s.apps, cols).map((cells, r) => {key: s.id + ":" + r, cells: cells, hiding: s.hiding == true, folder: s.folder ?? ""})
    ])))
  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(renamedAll.filter(a => !get(hidden, a.key, false)), typed) : []
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; anything else, a prompt of more lines among it, goes to the agent.
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  // What Enter acts on: a result by its place in hits, or -1 for the ask row.
  let chosen = pick ?? (opens ? 0 : -1)
  let agent = ag.default
  // With a keyboard: Up and Tab move the pick away from the bar, Down and Shift+Tab back; the ask row sits lowest.
  onKey: {
    if searching && iconPicking == "" {
      pick = clamp(chosen + (value == "up" || value == "tab" ? 1 : -1), -1, len(hits) - 1)
    }
  }

  // Typing starts the pick over, at the best match.
  on typed { pick = null }

  // How much the drawer covers home: near-opaque, as home's widgets showing through make the icons hard to read.
  opacity: 0.97
  // Leave the keyboard down as the drawer opens; tapping the bar still brings it up to search.
  keyboard: false
  enter: searching && iconPicking == "" ? (chosen >= 0 ? "▸ " + str.open : "⏎ " + str.ask) : ""
  // An empty bar's Enter does nothing, as on home.
  onSubmit: {
    if searching && iconPicking == "" {
      if chosen >= 0 {
        open(hits[chosen].key)
      } else if !linux {
        launcher("linux")
      } else {
        ask(value)
      }
    }
  }

  // Apps whose icon is a full-bleed square with an opaque background: monochrome tint floods the whole square with
  // the accent, so they show their initials on a badge instead, as an app without an icon does. Add a key to the list
  // to give another app the same treatment.
  let initialsOnly = ["a:com.philips.hearlink2/crc641d37fc9d5495f985.MainActivity"]
  // An app's icon as the drawer draws it: the one it was given, or its own, its silhouette on a badge with monochrome
  // icons, or its initials.
  component AppIcon(a, given = null) {
    let kind = get(given, "kind", "")
    let value = get(given, "value", "")
    // Another app's icon is drawn as that app draws it.
    let who = kind == "app" ? (find(d.apps, x => x.key == value) ?? a) : a
    let own = (kind == "" || kind == "app") && who.hasIcon && !any(initialsOnly, k => k == who.key)
    Box {
      size: 40
      align: center
      radius: 20 * corners
      background: own && !d.monochrome ? transparent : surface
      if kind == "file" {
        Image { src: value; size: 28; tint: d.monochrome ? accent : null; label: a.label }
      } else if own {
        Image { src: who.icon; size: d.monochrome ? 28 : 40; tint: d.monochrome ? accent : null; label: a.label }
      } else {
        Text { text: kind == "text" ? value : who.initials; fontSize: kind == "text" && len(value) < 2 ? 20 : 15; color: accent; maxLines: 1 }
      }
    }
  }

  // One app a row: its icon, then its name beside it. A long press opens its menu: rename, folder, hide among it.
  component Cell(a, picked, hiding, folder) {
    Row {
      weight: 1
      fill: width
      align: center
      gap: 14
      padding: [6, 14]
      radius: 16 * corners
      border: picked ? 2 : 0
      borderColor: accent
      // Paused work apps show dimmed; opening one turns work apps back on.
      opacity: a.paused ? 0.4 : 1
      onTap: open(a.key)
      onLongPress: {
        haptic()
        menuShortcuts = null
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }
      AppIcon { a: a; given: get(icons, a.key, null) }
      Text { text: a.name; fontSize: 15; maxLines: 1; weight: 1 }
      Popup {
        visible: menu == a.key && menuShortcuts != null
        position: above
        onDismiss: { menu = ""; renaming = ""; picking = "" }
        width: 220
        gap: 0
        if renaming == a.key {
          // Renaming: the field holds the app's given name, or its own while it has none; empty brings its own back.
          Input {
            text: get(names, a.key, a.name)
            fill: width
            fontSize: 15
            padding: [12, 12]
            onSubmit: {
              if trim(value) == "" {
                names = remove(names, a.key)
              } else {
                names = set(names, a.key, trim(value))
              }
              renaming = ""
              menu = ""
            }
          }
        } else if picking == a.key {
          // Picking a folder: each there is, then a field for a new one's name.
          for f in keys(folders) key f {
            Text {
              text: f
              fontSize: 15
              fill: width
              padding: [12, 12]
              onTap: {
                folders = set(folders, f, flatten([get(folders, f, []), [a.key]]))
                picking = ""
                menu = ""
              }
            }
          }
          Input {
            placeholder: str.newFolder
            fill: width
            fontSize: 15
            padding: [12, 12]
            onSubmit: {
              if trim(value) != "" {
                folders = set(folders, trim(value), flatten([get(folders, trim(value), []), [a.key]]))
              }
              picking = ""
              menu = ""
            }
          }
        } else {
          // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
          for s in menuShortcuts key s.key {
            Row {
              fill: width
              align: center
              gap: 10
              padding: [12, 6]
              onTap: { menu = ""; open(s.key) }
              Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
              Text { text: s.name; weight: 1; maxLines: 1 }
              Text { text: "[+]"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
            }
          }
          Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
          for w in a.actions {
            Text { text: get(str, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
          }
          Spacer { height: 1; fill: width; background: border }
          // Rename gives the app a name of its own; a folder moves it into a section up top.
          Text { text: str.rename; fontSize: 15; fill: width; padding: [12, 12]; onTap: renaming = a.key }
          // Icon picks what the app shows instead of its own: a character, a file, or another app's icon.
          Text { text: str.icon; fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; iconPicking = a.key } }
          Text {
            text: folder == "" ? str.addToFolder : str.removeFromFolder
            fontSize: 15
            fill: width
            padding: [12, 12]
            visible: !hiding
            onTap: {
              if folder == "" {
                picking = a.key
              } else {
                folders = set(folders, folder, get(folders, folder, []).filter(k => k != a.key))
                menu = ""
              }
            }
          }
          // Hide takes the app out of the list and search; the hidden section at the end unhides it.
          Text {
            text: hiding ? str.unhide : str.hide
            fontSize: 15
            color: hiding ? accent : foreground
            fill: width
            padding: [12, 12]
            onTap: {
              menu = ""
              if hiding {
                hidden = remove(hidden, a.key)
              } else {
                hidden = set(hidden, a.key, true)
              }
            }
          }
        }
      }
    }
  }

  Column {
    gap: 0
    padding: [12, 0]
    Row {
      align: center
      padding: [0, 12, 0, 8]
      gap: 0
      // Typing searches every profile, so the tabs step aside.
      for t in d.work != null && !searching ? ["personal", "work"] : [] {
        Text { text: get(str, t); color: tab == t ? accent : muted; background: tab == t ? surface : transparent; radius: 18 * corners; padding: [14, 10]; onTap: tab = t }
      }
      Spacer { weight: 1 }
      Box {
        size: 44
        radius: 22 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: str.settings }
        // System updates are waiting: settings › system updates lists them.
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }
    Column {
      visible: !searching && iconPicking == ""
      lazy: true
      weight: 1
      fill: width
      gap: 0
      for row in rows key row.key {
        if row.title != null {
          // A section's title, with the work switch or the offer to install Linux at its end.
          Row {
            fill: width
            gap: 0
            align: center
            padding: [8, 12, 0, 4]
            Text {
              text: row.title
              color: muted
              weight: 1
              // A folder's title opens its menu on a long press: deleting it brings its apps back to the list.
              onLongPress: {
                if row.folder != "" {
                  haptic()
                  folderMenu = row.folder
                }
              }
            }
            Popup {
              visible: folderMenu == row.folder && row.folder != ""
              onDismiss: folderMenu = ""
              width: 200
              Text {
                text: str.deleteFolder
                fontSize: 15
                fill: width
                padding: [12, 12]
                onTap: {
                  folders = remove(folders, folderMenu)
                  folderMenu = ""
                }
              }
            }
            Text { text: "[" + (d.work.paused ? str.turnOn : str.pause) + "]"; visible: row.work == true; color: accent; onTap: workApps("toggle") }
            Text { text: "[" + (d.linux == "installing" ? str.installing : str.installLinux) + "]"; visible: row.offer == true; color: accent; onTap: launcher("linux") }
          }
        } else {
          Row {
            fill: width
            gap: 0
            for a in row.cells { Cell { a: a; picked: false; hiding: row.hiding; folder: row.folder ?? "" } }
            // A short last row keeps its cells the width of the others'.
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    // Picking an app's icon: its own or its initials, a character or a file, or another app's icon.
    Column {
      visible: iconPicking != ""
      weight: 1
      fill: width
      gap: 0
      padding: [4, 0]
      Row {
        align: center
        gap: 12
        padding: [8, 12, 0, 8]
        Text { text: str.icon + " · " + iconPickingName.name; color: muted; weight: 1; maxLines: 1 }
        Text { text: str.cancel; color: accent; onTap: iconPicking = "" }
      }
      Row {
        gap: 12
        padding: [8, 12, 0, 8]
        Text { text: str.ownIcon; color: accent; onTap: { icons = remove(icons, iconPicking); iconPicking = "" } }
        Text { text: str.initialsIcon; color: accent; onTap: { icons = set(icons, iconPicking, {kind: "initials", value: ""}); iconPicking = "" } }
      }
      // A character or emoji as the icon.
      Input {
        placeholder: str.typeIcon
        fill: width
        fontSize: 15
        padding: [12, 12]
        onSubmit: {
          if trim(value) != "" {
            icons = set(icons, iconPicking, {kind: "text", value: trim(value)})
            iconPicking = ""
          }
        }
      }
      // An svg or png in this system as the icon.
      Input {
        placeholder: str.iconFile
        fill: width
        fontSize: 15
        padding: [12, 12]
        onSubmit: {
          if trim(value) != "" {
            icons = set(icons, iconPicking, {kind: "file", value: trim(value)})
            iconPicking = ""
          }
        }
      }
      Text { text: str.borrowIcon; color: muted; padding: [12, 12, 0, 8] }
      Column {
        lazy: true
        weight: 1
        fill: width
        gap: 0
        for row in borrowRows key row.key {
          Row {
            fill: width
            gap: 8
            padding: [2, 12]
            for a in row.cells {
              Box {
                size: 44
                radius: 22 * corners
                align: center
                onTap: {
                  icons = set(icons, iconPicking, {kind: "app", value: a.key})
                  iconPicking = ""
                }
                AppIcon { a: a }
              }
            }
          }
        }
      }
    }
    Column {
      visible: searching && iconPicking == ""
      lazy: true
      reverse: true
      weight: 1
      fill: width
      gap: 0
      for row in hitRows key row.key {
        Row {
          fill: width
          gap: 0
          for a, i in row.cells { Cell { a: a; picked: row.start + i == chosen; hiding: false; folder: "" } }
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
    // The one line above the bar that sends what's typed to the agent; outlined when that's what Enter does.
    Row {
      visible: searching && iconPicking == ""
      fill: width
      gap: 4
      padding: [12, 10]
      border: chosen == -1 ? 2 : 0
      borderColor: accent
      radius: 16 * corners
      onTap: {
        if !linux {
          launcher("linux")
        } else if agent == null {
          launcher("agents")
        } else {
          ask(typed)
        }
      }
      Text { text: "⏎"; color: chosen == -1 ? accent : muted }
      Text {
        text: !linux ? str.askInstallLinux : agent == null ? str.askInstallAgent : str.askAgent(agent.bin, typed)
        color: chosen == -1 ? foreground : muted
        maxLines: 1
        weight: 1
      }
    }
  }
}
